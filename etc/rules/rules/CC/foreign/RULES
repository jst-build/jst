local common = import '//expressions.jst';
local cc = import '//CC/expressions.jst';
local transitions = import '//transitions/expressions.jst';

// Get values from field by name, or return the given default value
local get_field(name, default) =
  local val = jst.field(name);
  if val then val else default;

{
  defaults: {
    doc: |||
      A rule to provide defaults for foreign rules.
      All foreign rules take their defaults for MAKE, CMAKE, etc from
      the target `//CC/foreign:defaults`.
    |||,
    target_fields: ['base', 'toolchain'],
    string_fields: ['MAKE', 'CMAKE', 'PATH', 'SYSTEM_TOOLS'],
    field_doc: {
      base: 'Other targets (using the same rule) to inherit values from.',
      toolchain: |||
        Optional toolchain directory. A collection of artifacts that provide
        the tools MAKE, CMAKE. Note that only artifacts of
        the specified targets are considered (no runfiles etc.). Specifying
        this field extends artifacts from `base`.
      |||,
      MAKE: 'The make binary to use',
      CMAKE: 'The cmake binary to use',
      SYSTEM_TOOLS: |||
        List of tools (`'MAKE'`, `'CMAKE'`) that should be taken from
        the system instead of from `toolchain` (if specified).
      |||,
      PATH: |||
        Path for looking up the tools. Individual paths are joined with
        with `':'`. Specifying this field extends values from `base`.
      |||,
    },
    config_vars: ['ARCH', 'HOST_ARCH'],
    config_transitions: {
      toolchain: [transitions.for_host()],
    },
    expression:
      local make_tool = get_field('MAKE', cc.defaults_base_provides(provider='MAKE'));
      local cmake_tool = get_field('CMAKE', cc.defaults_base_provides(provider='CMAKE'));
      local path = jst.nub_left(
        jst.field('PATH')
        + cc.defaults_base_provides__concat(provider='PATH'),
      );
      local env = cc.defaults_base_provides(provider='ENV', default={});
      local non_system_tools = jst.union(
        jst.flatten(
          [
            cc.defaults_base_provides_list(
              provider='NON_SYSTEM_TOOLS',
              default={},
            ),
            if jst.field('MAKE') then
              [{MAKE: if jst.field('toolchain') then true else false}],
            if jst.field('CMAKE') then
              [{CMAKE: if jst.field('toolchain') then true else false}],
            [{[tool]: false} for tool in jst.field('SYSTEM_TOOLS')],
          ],
        ),
      );
      local toolchain = jst.union(
        cc.defaults_base_provides_list(provider='TOOLCHAIN', default={})
        + (if jst.field('toolchain') then
          common.field_artifacts_list(
            fieldname='toolchain',
            transition=transitions.for_host(),
          )),
        disjoint=true,
        msg='toolchain artifacts may not overlap',
      );
      jst.result(
        provides={
          MAKE: make_tool,
          CMAKE: cmake_tool,
          PATH: path,
          ENV: env,
          TOOLCHAIN: toolchain,
          NON_SYSTEM_TOOLS: non_system_tools,
        },
      ),
  },
}
