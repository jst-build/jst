local common = import '//expressions.jst';
local cc = import '//CC/expressions.jst';
local cc_foreign = import '//CC/foreign/expressions.jst';
local cc_foreign_cmake = import '//CC/foreign/cmake/expressions.jst';
local cc_prebuilt = import '//CC/prebuilt/expressions.jst';
local shell = import '//shell/expressions.jst';
local transitions = import '//transitions/expressions.jst';

{
  data: {
    doc: |||
      Data produced by CMake configure, build, and install.

      All variables accessible to commands and options are: `TMPDIR`,
      `LOCALBASE`, `CC`, `CXX`, `CFLAGS`, `CXXFLAGS`, `LDFLAGS`,
      and `AR`. `LOCALBASE` contains the path to the installed artifacts
      from `deps`.
    |||,
    target_fields: ['project'],
    bool_fields: ['resolve_symlinks'],
    string_fields: [
      'subdir',
      'options',
      'defines',
      'targets',
      'jobs',
      'pre_cmds',
      'post_cmds',
      'out_files',
      'out_dirs',
    ],
    config_vars: [
      'ARCH',
      'HOST_ARCH',
      'CC',
      'CXX',
      'CFLAGS',
      'CXXFLAGS',
      'LDFLAGS',
      'ADD_CFLAGS',
      'ADD_CXXFLAGS',
      'ADD_LDFLAGS',
      'ENV',
      'AR',
      'BUILD_POSITION_INDEPENDENT',
      'TIMEOUT_SCALE',
      'FOREIGN_EXECUTION_PROPERTIES',
    ],
    implicit: {
      defaults: ['//CC:defaults'],
      'foreign-defaults': ['//CC/foreign:defaults'],
      'shell defaults': ['//shell:defaults'],
      expand_exec: ['./..:expand_exec'],
    },
    field_doc: {
      project:
        'The CMake project directory. It should contain a single tree artifact',
      subdir: |||
        The subdirectory that contains the entry CMakeLists.txt. Individual
        directory components are joined with `'/'`.
      |||,
      options: |||
        CMake options for the configuration phase.
        (e.g., `['-GNinja', '-Ax64']`)
      |||,
      defines: |||
        CMake defines for the configuration phase.
        (e.g., `['CMAKE_BUILD_TYPE=Release']`)
      |||,
      targets: |||
        The CMake targets to build in the specified order
        (default: `['install']`).
      |||,
      jobs: |||
        Number of jobs to run simultaneously. If omitted, CMake's default
        number is used.
      |||,
      pre_cmds: |||
        List of commands executed in the project directory before calling
        CMake. Useful for renaming files or directories. Note that data
        between `pre_cmds` and `post_cmds` can be exchanged via
        `'$TMPDIR'` which is uniquely reserved for this action.
      |||,
      post_cmds: |||
        List of commands executed in the install directory after successful
        installation but before the output files are collected. Useful for
        renaming files or directories. Note that data between `pre_cmds` and
        `post_cmds` can be exchanged via `'$TMPDIR'`, which is uniquely
        reserved for this action. The CMake source and build directory can be
        accessed via `'$CMAKE_SOURCE_DIR'` and `'$CMAKE_BINARY_DIR'`,
        respectively.
      |||,
      resolve_symlinks: |||
        Resolve all symlinks in the install directory. This operation is
        performed immediately after the install, before `post_cmds` are run.
      |||,
      out_files: |||
        Paths to the produced output files. The paths are considered relative
        to the install directory.
        Note that `out_files` and `out_dirs` may not overlap.
      |||,
      out_dirs: |||
        Paths to the produced output directories. The paths are considered
        relative to the install directory.
        Note that `out_files` and `out_dirs` may not overlap.
      |||,
    },
    config_doc: {
      CC: |||
        The name of the C compiler to be used.
        If null, the respective value from `//CC:defaults` will be taken.
      |||,
      CXX: |||
        The name of the C++ compiler to be used.
        If null, the respective value from `//CC:defaults` will be taken.
      |||,
      CFLAGS: |||
        The flags for CC to be used instead of the default ones.
        For libraries that should be built in a non-standard way; usually
        adapting the default target `//CC:defaults` is the better
        choice
      |||,
      CXXFLAGS: |||
        The flags for CXX to be used instead of the default ones.
        For libraries that should be built in a non-standard way; usually
        adapting the default target `//CC:defaults` is the better
        choice.
      |||,
      LDFLAGS: |||
        The linker flags to be used instead of the default ones.
        For libraries that should be linked in a non-standard way; usually
        adapting the default target `//CC:defaults` is the better
        choice
      |||,
      ADD_CFLAGS: |||
        The flags to add to the default ones for CC.
        For libraries that should be built in a non-standard way; usually
        adapting the default target `//CC:defaults` is the better
        choice.
      |||,
      ADD_CXXFLAGS: |||
        The flags to add to the default ones for CXX.
        For libraries that should be built in a non-standard way; usually
        adapting the default target `//CC:defaults` is the better
        choice.
      |||,
      ADD_LDFLAGS: |||
        The linker flags to add to the default ones.
        For libraries that should be linked in a non-standard way; usually
        adapting the default target `//CC:defaults` is the better
        choice.
      |||,
      ENV: |||
        The environment for any action generated.
        If null, the respective value from `//CC:defaults` will be taken.
      |||,
      AR: |||
        The archive tool to used for creating the library.
        If null, the respective value from `//CC:defaults` will be taken.
      |||,
      BUILD_POSITION_INDEPENDENT: 'Build position independent code.',
      TIMEOUT_SCALE: |||
        The scaling of the timeout for the invocation of the foreign build.
        Defaults to 10.
      |||,
      FOREIGN_EXECUTION_PROPERTIES: |||
        A map with extra remote-execution properties to be added to the foreign
        build action.
      |||,
    },
    config_transitions: {
      defaults: [
        {},
        transitions.for_host(),
      ],
      expand_exec: [
        transitions.for_host(),
      ],
    },
    expression:
      local install_prefix = 'install';
      local source_dir = common.stage_singleton_field(
        fieldname='project',
        location='source',
      );
      local installed_out_files = [
        jst.join([install_prefix, file_path], sep='/')
        for file_path in jst.field('out_files')
      ];
      local installed_out_dirs = [
        jst.join([install_prefix, dir_path], sep='/')
        for dir_path in jst.field('out_dirs')
      ];
      local cmake_subdir = jst.field('subdir');
      local cmake_options = jst.field('options');
      local cmake_defines = jst.field('defines');
      local cmake_targets = jst.field('targets');
      local cmake_jobs = jst.field('jobs');
      local pre_cmds = jst.field('pre_cmds');
      local post_cmds = jst.field('post_cmds');
      local resolve_symlinks = jst.field('resolve_symlinks');
      local defaults_transition = {};
      local expand_exec =
        local transition = transitions.for_host();
        common.stage_singleton_field(
          fieldname='expand_exec',
          transition=transition,
          location='expand_exec',
        );
      local full_install_dir = cc_foreign_cmake.cmake_build(
        source_dir=source_dir,
        cmake_subdir=cmake_subdir,
        cmake_options=cmake_options,
        cmake_defines=cmake_defines,
        cmake_jobs=cmake_jobs,
        cmake_targets=cmake_targets,
        pre_cmds=pre_cmds,
        post_cmds=post_cmds,
        defaults_transition=defaults_transition,
        expand_exec=expand_exec,
        resolve_symlinks=resolve_symlinks,
      );
      local shell_toolchain = common.field_map_provider(
        fieldname='shell defaults',
        provider='TOOLCHAIN',
      );
      local sh = shell.sh(
        defaults_transition=defaults_transition,
        toolchain_dir='toolchain',
        fieldname='shell defaults',
      );
      local sh_path = jst.join(
        shell.path(
          fieldname='shell defaults',
          defaults_transition=defaults_transition,
        ),
        sep=':',
      );
      local sh_env = if sh_path then {PATH: sh_path} else {};
      local install_dir = jst.action(
        inputs=shell_toolchain + full_install_dir,
        cmd=[sh, '-c', ':'],
        outs=installed_out_files,
        out_dirs=installed_out_dirs,
        env=sh_env + jst.env('ENV', default={}),
        label=
          'Extracting CMake '
          + jst.join_cmd(jst.field('out_files') + jst.field('out_dirs')),
      );
      local out_files =
        local paths = jst.field('out_files');
        cc_foreign.strip_prefix(
          artifacts=install_dir,
          paths=paths,
          prefix=install_prefix,
        );
      local out_dirs =
        local paths = jst.field('out_dirs');
        cc_foreign.strip_prefix(
          artifacts=install_dir,
          paths=paths,
          prefix=install_prefix,
        );
      jst.result(artifacts=jst.union(out_files + out_dirs)),
  },

  library: {
    doc: |||
      Library produced by CMake configure, build, and install.

      All variables accessible to commands and options are: `TMPDIR`,
      `LOCALBASE`, `CC`, `CXX`, `CFLAGS`, `CXXFLAGS`, `LDFLAGS`,
      and `AR`. `LOCALBASE` contains the path to the installed artifacts
      from `deps`.
    |||,
    target_fields: ['project', 'deps'],
    bool_fields: ['resolve_symlinks'],
    string_fields: [
      'subdir',
      'name',
      'version',
      'stage',
      'options',
      'defines',
      'jobs',
      'pre_cmds',
      'post_cmds',
      'out_hdrs',
      'out_hdr_dirs',
      'out_libs',
      'cflags',
      'ldflags',
      'pkg-config',
      'hdr_prefix',
      'lib_prefix',
      'pc_prefix',
    ],
    config_vars: [
      'ARCH',
      'HOST_ARCH',
      'CC',
      'CXX',
      'CFLAGS',
      'CXXFLAGS',
      'LDFLAGS',
      'ADD_CFLAGS',
      'ADD_CXXFLAGS',
      'ADD_LDFLAGS',
      'ENV',
      'AR',
      'BUILD_POSITION_INDEPENDENT',
      'TIMEOUT_SCALE',
      'FOREIGN_EXECUTION_PROPERTIES',
    ],
    implicit: {
      defaults: ['//CC:defaults'],
      'foreign-defaults': ['//CC/foreign:defaults'],
      'shell defaults': ['//shell:defaults'],
      config_reader: ['//CC:prebuilt/read_pkgconfig.py'],
      expand_exec: ['./..:expand_exec'],
    },
    field_doc: {
      project:
        'The CMake project directory. It should contain a single tree artifact',
      subdir: |||
        The subdirectory that contains the entry CMakeLists.txt. Individual
        directory components are joined with `'/'`.
      |||,
      name: |||
        The name of the library (without leading `'lib'` or trailing file name
        extension), also used as name for pkg-config files.
      |||,
      version: |||
        The library version, used for pkg-config files. Individual version
        components are joined with `'.'`.
      |||,
      options: |||
        CMake options for the configuration phase
        (e.g., `['-GNinja', '-Ax64']`). Variables can be accessed via
        `'$(<varname>)'`, e.g., `'$(TMPDIR)'` for variable `'$TMPDIR'`.
      |||,
      defines: |||
        CMake defines for the configuration phase
        (e.g., `['CMAKE_BUILD_TYPE=Release']`). Variables can be accessed via
        `'$(<varname>)'`, e.g., `'$(TMPDIR)'` for variable `'$TMPDIR'`.
      |||,
      jobs: |||
        Number of jobs to run simultaneously. If omitted, CMake's default
        number is used.
      |||,
      pre_cmds: |||
        List of commands executed in the project directory before calling
        CMake. Useful for renaming files or directories. Note that data
        between `pre_cmds` and `post_cmds` can be exchanged via
        `'$TMPDIR'` which is uniquely reserved for this action.
      |||,
      post_cmds: |||
        List of commands executed in the install directory after successful
        installation but before the output files are collected. Useful for
        renaming files or directories (e.g., in case of SONAME mismatch). Note
        that data between `pre_cmds` and `post_cmds` can be exchanged via
        `'$TMPDIR'`, which is uniquely reserved for this action. The CMake
        source and build directory can be accessed via `'$CMAKE_SOURCE_DIR'`
        and `'$CMAKE_BINARY_DIR'`, respectively.
      |||,
      resolve_symlinks: |||
        Resolve all symlinks in the install directory. This operation is
        performed immediately after the install, before `post_cmds` are run.
      |||,
      out_hdrs: |||
        Paths to produced public header files. The path is considered
        relative to the include directory, which be set via `hdr_prefix`.
        Note that `out_hdrs` and `out_hdr_dirs` may not overlap.
      |||,
      out_hdr_dirs: |||
        Paths to produced public header directories. The path is considered
        relative to the include directory, which be set via `hdr_prefix`.
        Note that `out_hdrs` and `out_hdr_dirs` may not overlap.
      |||,
      out_libs: |||
        Paths to produced library files. The path is considered relative
        to the library directory, which be set via `lib_prefix`.
        Order matters in the case of one library depending on another.
      |||,
      cflags: 'List of compile flags set for this target and its consumers.',
      ldflags: |||
        Additional linker flags that are required for the consumer of the
        produced libraries.
      |||,
      stage: |||
        The logical location of the public headers and library files.
        Individual directory components are joined with `'/'`.
      |||,
      deps: 'Public dependency on other CC libraries.',
      'pkg-config': |||
        Pkg-config file for optional infer of public cflags and ldflags. If
        multiple files are specified (e.g., one depends on the other), the
        first one is used as entry. Note that if this field is non-empty the
        tool `'pkg-config'` must be available in `PATH`, which is taken
        from `//CC:defaults` or the `ENV` variable.
      |||,
      hdr_prefix: |||
        Prefix where headers will be installed by CMake. Individual directory
        components are joined with `'/'`. Defaults to `'include'` if not set.
      |||,
      lib_prefix: |||
        Prefix where libraries will be installed by CMake. Individual
        directory components are joined with `'/'`. Defaults to `'lib'` if
        not set.
      |||,
      pc_prefix: |||
        Prefix where pkg-config files will be installed by CMake. Individual
        directory components are joined with `'/'`. Defaults to
        `'lib/pkgconfig'` if not set.
      |||,
    },
    config_doc: {
      CC: |||
        The name of the C compiler to be used.
        If null, the respective value from `//CC:defaults` will be taken.
      |||,
      CXX: |||
        The name of the C++ compiler to be used.
        If null, the respective value from `//CC:defaults` will be taken.
      |||,
      CFLAGS: |||
        The flags for CC to be used instead of the default ones.
        For libraries that should be built in a non-standard way; usually
        adapting the default target `//CC:defaults` is the better
        choice
      |||,
      CXXFLAGS: |||
        The flags for CXX to be used instead of the default ones.
        For libraries that should be built in a non-standard way; usually
        adapting the default target `//CC:defaults` is the better
        choice.
      |||,
      LDFLAGS:
        'Global ld flags, for common link args,such as -Wl,-z,noexecstack',
      ADD_CFLAGS: |||
        The flags to add to the default ones for CC.
        For libraries that should be built in a non-standard way; usually
        adapting the default target `//CC:defaults` is the better
        choice.
      |||,
      ADD_CXXFLAGS: |||
        The flags to add to the default ones for CXX.
        For libraries that should be built in a non-standard way; usually
        adapting the default target `//CC:defaults` is the better
        choice.
      |||,
      ADD_LDFLAGS: |||
        The linker flags to add to the default ones.
        For libraries that should be linked in a non-standard way; usually
        adapting the default target `//CC:defaults` is the better
        choice.
      |||,
      ENV: |||
        The environment for any action generated.
        If null, the respective value from `//CC:defaults` will be taken.
      |||,
      AR: |||
        The archive tool to used for creating the library
        If null, the respective value from `//CC:defaults` will be taken.
      |||,
      BUILD_POSITION_INDEPENDENT: 'Build position independent code.',
      TIMEOUT_SCALE: |||
        The scaling of the timeout for the invocation of the foreign build.
        Defaults to 10.
      |||,
      FOREIGN_EXECUTION_PROPERTIES: |||
        A map with extra remote-execution properties to be added to the foreign
        build action.
      |||,
    },
    config_transitions: {
      defaults: [{}, transitions.for_host()],
      expand_exec: [transitions.for_host()],
    },
    expression:
      local hdr_prefix = jst.join(
        ['install']
        + (if jst.field('hdr_prefix') then
          jst.field('hdr_prefix')
        else
          ['include']),
        sep='/',
      );
      local lib_prefix_ = jst.join(
        ['install']
        + (if jst.field('lib_prefix') then
          jst.field('lib_prefix')
        else
          ['lib']),
        sep='/',
      );
      local pc_prefix = jst.join(
        ['install']
        + (if jst.field('pc_prefix') then
          jst.field('pc_prefix')
        else
          ['lib', 'pkgconfig']),
        sep='/',
      );
      local source_dir = common.stage_singleton_field(
        fieldname='project',
        location='source',
      );
      local localbase_dir = jst.to_subdir(
        local targets = jst.field('deps');
        cc.install_with_deps_stage(
          pc_install_dir='lib/pkgconfig',
          targets=targets,
        ),
        subdir='localbase',
        msg='dependency installation files may not overlap',
      );
      local installed_dirs = [
        jst.join([hdr_prefix, dir_path], sep='/')
        for dir_path in jst.field('out_hdr_dirs')
      ];
      local installed_files =
        [
          jst.join([lib_prefix_, lib_path], sep='/')
          for lib_path in jst.field('out_libs')
        ]
        + [
          jst.join([hdr_prefix, hdr_path], sep='/')
          for hdr_path in jst.field('out_hdrs')
        ]
        + [
          jst.join([pc_prefix, pc_path], sep='/')
          for pc_path in jst.field('pkg-config')
        ];
      local cmake_subdir = jst.field('subdir');
      local cmake_options = jst.field('options');
      local cmake_defines = jst.field('defines');
      local cmake_jobs = jst.field('jobs');
      local pre_cmds = jst.field('pre_cmds');
      local post_cmds = jst.field('post_cmds');
      local resolve_symlinks = jst.field('resolve_symlinks');
      local defaults_transition = {};
      local expand_exec =
        common.stage_singleton_field(
          fieldname='expand_exec',
          transition=transitions.for_host(),
          location='expand_exec',
        );
      local full_install_dir = cc_foreign_cmake.cmake_build(
        source_dir=source_dir,
        cmake_subdir=cmake_subdir,
        localbase_dir=localbase_dir,
        cmake_options=cmake_options,
        cmake_defines=cmake_defines,
        cmake_jobs=cmake_jobs,
        pre_cmds=pre_cmds,
        post_cmds=post_cmds,
        defaults_transition=defaults_transition,
        expand_exec=expand_exec,
        resolve_symlinks=resolve_symlinks,
      );
      local shell_toolchain = common.field_map_provider(
        fieldname='shell defaults',
        provider='TOOLCHAIN',
      );
      local sh = shell.sh(
        defaults_transition=defaults_transition,
        fieldname='shell defaults',
      );
      local sh_path = jst.join(
        shell.path(
          fieldname='shell defaults',
          defaults_transition=defaults_transition,
        ),
        sep=':',
      );
      local sh_env = if sh_path then {PATH: sh_path} else {};
      local install_dir = jst.action(
        inputs=shell_toolchain + full_install_dir,
        cmd=[sh, '-c', ':'],
        outs=installed_files,
        out_dirs=installed_dirs,
        env=sh_env + jst.env('ENV', default={}),
        label=
          'Extracting CMake '
          + jst.join_cmd(
            jst.flatten(
              [
                jst.field('out_libs'),
                jst.field('out_hdrs'),
                jst.field('out_hdr_dirs'),
              ],
            ),
          ),
      );
      local hdrs =
        (
          local paths = jst.field('out_hdrs');
          cc_foreign.strip_prefix(
            artifacts=install_dir,
            paths=paths,
            prefix=hdr_prefix,
          )
        )
        + (
          local paths = jst.field('out_hdr_dirs');
          cc_foreign.strip_prefix(
            artifacts=install_dir,
            paths=paths,
            prefix=hdr_prefix,
          )
        );
      local libs =
        local paths = jst.field('out_libs');
        cc_foreign.strip_prefix(
          artifacts=install_dir,
          paths=paths,
          prefix=lib_prefix_,
        );
      local config_reader = common.stage_singleton_field(
        fieldname='config_reader',
        location='config_reader',
      );
      local pkg_configs =
        local paths = jst.field('pkg-config');
        cc_foreign.strip_prefix(
          artifacts=install_dir,
          paths=paths,
          prefix=pc_prefix,
        );
      local name = jst.assert_non_empty(
        jst.join(jst.field('name')),
        msg='name is required for cmake library',
      );
      local version = jst.field('version');
      local cflags = jst.field('cflags');
      local ldflags = jst.field('ldflags');
      local stage = jst.join(jst.field('stage'), sep='/');
      cc_prebuilt.prebuilt_result(
        name=name,
        version=version,
        stage=stage,
        cflags=cflags,
        ldflags=ldflags,
        libs=libs,
        hdrs=hdrs,
        config_reader=config_reader,
        pkg_configs=pkg_configs,
        deps_fieldnames=['deps', 'defaults'],
      ),
  },
}
