local common = import '//expressions.jst';
local cc = import '//CC/expressions.jst';
local cc_foreign = import '//CC/foreign/expressions.jst';
local shell = import '//shell/expressions.jst';

// Configure, build, and install a CMake project; return the action's
// output directory "install".
// - `source_dir`       The staged project sources.
// - `cmake_options`    Additional options for CMake.
// - `cmake_defines`    Defines for CMake (passed as "-D").
// - `cmake_jobs`       Number of parallel jobs.
// - `pre_cmds`         Commands to run before the build.
// - `post_cmds`        Commands to run after the build.
// - `expand_exec`      The tool expanding variables in command lines.
// - `resolve_symlinks` Resolve symlinks in the installed artifacts.
// - `cmake_subdir`     The subdirectory of the project to build.
// - `localbase_dir`    Staged dependencies (LOCALBASE).
// - `cmake_targets`    The targets to build (default: ["install"]).
local cmake_build(source_dir, cmake_options, cmake_defines, cmake_jobs, pre_cmds, post_cmds, expand_exec, resolve_symlinks, cmake_subdir=[], localbase_dir={}, cmake_targets=null, defaults_transition={}) =
  local toolchain_dir = 'toolchain';
  local shell_toolchain = common.field_map_provider(
    fieldname='shell defaults',
    provider='TOOLCHAIN',
  );
  local sh = shell.sh(
    defaults_transition=defaults_transition,
    toolchain_dir=toolchain_dir,
    fieldname='shell defaults',
  );
  local toolchain = jst.union(
    [
      cc_foreign.default_toolchain(defaults_transition=defaults_transition),
      cc.default_toolchain(defaults_transition=defaults_transition),
      shell_toolchain,
    ],
    disjoint=true,
    msg='Toolchain trees may not overlap',
  );
  local toolchain = jst.to_subdir(toolchain, subdir=toolchain_dir);
  local non_system_tools =
    cc_foreign.default_non_system_tools(
      defaults_transition=defaults_transition,
    )
    + cc.default_non_system_tools(defaults_transition=defaults_transition);
  local cmake_flags = jst.flatten(
    [
      ['-D' + define for define in cmake_defines],
      cmake_options,
      if $BUILD_POSITION_INDEPENDENT then
        ['-DCMAKE_POSITION_INDEPENDENT_CODE=ON'],
      ['-DCMAKE_INSTALL_RPATH=$ORIGIN;$ORIGIN/../lib'],
    ],
  );
  local build_position_independent = null;
  local make_tool = jst.join(
    (if jst.get('MAKE', non_system_tools) then ['./', toolchain_dir, '/'])
    + cc_foreign.default_make(defaults_transition=defaults_transition),
  );
  local cmake_tool = jst.join(
    (if jst.get('CMAKE', non_system_tools) then ['./', toolchain_dir, '/'])
    + cc_foreign.default_cmake(defaults_transition=defaults_transition),
  );
  local cc_tool = cc.compiler_cc(
    toolchain_dir=toolchain_dir,
    non_system_tools=non_system_tools,
    defaults_transition=defaults_transition,
  );
  local cxx_tool = cc.compiler_cxx(
    toolchain_dir=toolchain_dir,
    non_system_tools=non_system_tools,
    defaults_transition=defaults_transition,
  );
  local cflags = jst.join(
    cc.flags_cc(
      build_position_independent=build_position_independent,
      defaults_transition=defaults_transition,
    ),
    sep=' ',
  );
  local cxxflags = jst.join(
    cc.flags_cxx(
      build_position_independent=build_position_independent,
      defaults_transition=defaults_transition,
    ),
    sep=' ',
  );
  local ldflags = jst.join(
    jst.env(
      'LDFLAGS',
      default=cc.default_ldflags(defaults_transition=defaults_transition),
    ),
    sep=' ',
  );
  local ar_tool =
    jst.env(
      'AR',
      default=jst.join(
        (if jst.get('AR', non_system_tools) then ['./', toolchain_dir, '/'])
        + cc.default_ar(defaults_transition=defaults_transition),
      ),
    );
  local sh_path = jst.join(
    shell.path(
      fieldname='shell defaults',
      defaults_transition=defaults_transition,
    ),
    sep=':',
  );
  local sh_env = if sh_path then {PATH: sh_path} else {};
  local path = jst.join(
    jst.nub_left(
      cc_foreign.default_path(defaults_transition=defaults_transition)
      + cc.default_path(defaults_transition=defaults_transition),
    ),
    sep=':',
  );
  local env = jst.union(
    [
      {
        CC: cc_tool,
        CXX: cxx_tool,
        CXXFLAGS: cxxflags,
        CFLAGS: cflags,
        LDFLAGS: ldflags,
        AR: ar_tool,
        MAKE: make_tool,
        CMAKE: cmake_tool,
      },
      sh_env,
      cc.default_env(defaults_transition=defaults_transition),
      cc_foreign.default_env(defaults_transition=defaults_transition),
      jst.env('ENV', default={}),
    ],
  );
  local cmake_jobs =
    if cmake_jobs then
      ['CMAKE_BUILD_PARALLEL_LEVEL=' + jst.join_cmd(cmake_jobs)];
  local cmake_subdir = jst.join(cmake_subdir, sep='/');
  local cmake_targets = if cmake_targets then cmake_targets else ['install'];
  local script = {
    'run_cmake.sh': jst.make_blob(
      jst.join(
        jst.flatten(
          [
            [
              'set -eu',
              'mkdir -p scratch install',
              'readonly ROOT="$(pwd)"',
              'export TMPDIR="$(pwd)/scratch"',
              'export TOOLCHAIN="$(pwd)/toolchain"',
              'export LOCALBASE="$(pwd)/localbase"',
              if jst.get('CC', non_system_tools) then
                'export CC=$(pwd)/${CC}'
              else
                '',
              if jst.get('CXX', non_system_tools) then
                'export CXX=$(pwd)/${CXX}'
              else
                '',
              if jst.get('AR', non_system_tools) then
                'export AR=$(pwd)/${AR}'
              else
                '',
              if jst.get('MAKE', non_system_tools) then
                'export MAKE=$(pwd)/${MAKE}'
              else
                '',
              if jst.get('CMAKE', non_system_tools) then
                'export CMAKE=$(pwd)/${CMAKE}'
              else
                '',
              jst.join(
                ['export PATH=', jst.join_cmd([path]), '${PATH:+:}"${PATH}"'],
              ),
            ],
            if pre_cmds then
              jst.flatten([['(', 'set --', 'cd ./source'], pre_cmds, [')']]),
            [
              'readonly CMAKE_SUBDIR="$1"',
              'readonly CMAKE_AR=$(command -v $2)',
              'shift 2',
            ],
            [
              jst.join(
                [
                  '${ROOT}/expand_exec TMPDIR LOCALBASE CC CXX CFLAGS CXXFLAGS LDFLAGS AR',
                  '--',
                  '${CMAKE} -S"source/${CMAKE_SUBDIR}" -Bbuild',
                  '-DCMAKE_MAKE_PROGRAM=${MAKE}',
                  '-DCMAKE_AR=${CMAKE_AR}',
                  '-DCMAKE_INSTALL_PREFIX=./install',
                  '-DCMAKE_PREFIX_PATH="$(pwd)/localbase"',
                  '-DPKG_CONFIG_ARGN=--define-prefix',
                  '--no-warn-unused-cli',
                  '"$@"',
                  '>configure.log 2>&1 || (cat configure.log && exit 1)',
                ],
                sep=' ',
              ),
            ],
            [
              jst.join(
                cmake_jobs
                + [
                  '${ROOT}/expand_exec TMPDIR LOCALBASE CC CXX CFLAGS CXXFLAGS LDFLAGS AR',
                  '--',
                  '${CMAKE} --build build --target',
                  jst.join_cmd([target]),
                  '>>build.log 2>&1 || (cat configure.log build.log && exit 1)',
                ],
                sep=' ',
              )
              for target in cmake_targets
            ],
            if resolve_symlinks then
              [
                'mv install install_with_symlinks',
                'cp -rL install_with_symlinks install >copy.log 2>&1 || (echo \'ERROR: symlink resolve failed with:\' && cat copy.log && exit 1)',
              ],
            if post_cmds then
              jst.flatten(
                [
                  [
                    '(',
                    'set --',
                    'readonly CMAKE_SOURCE_DIR="$(pwd)/source"',
                    'readonly CMAKE_BINARY_DIR="$(pwd)/build"',
                    'cd ./install',
                  ],
                  post_cmds,
                  [')'],
                ],
              ),
          ],
        ),
        sep='\n',
      ),
    ),
  };
  jst.action(
    inputs=jst.union(
      [toolchain, source_dir, expand_exec, localbase_dir, script],
    ),
    cmd=[sh, 'run_cmake.sh', cmake_subdir, ar_tool] + cmake_flags,
    out_dirs=['install'],
    env=env,
    label='Building CMake ' + jst.join_cmd(cmake_targets),
    timeout_scaling=jst.env('TIMEOUT_SCALE', default=10),
    execution_properties=$FOREIGN_EXECUTION_PROPERTIES,
  );

{cmake_build: cmake_build}
