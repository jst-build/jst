local common = import '//expressions.jst';
local cc = import '//CC/expressions.jst';
local cc_proto = import '//CC/proto/expressions.jst';
local transitions = import '//transitions/expressions.jst';

// Get values from field by name, or return the given default value
local get_field(name, default) =
  local val = jst.field(name);
  if val then val else default;

{
  defaults: {
    doc: |||
      A rule to provide protoc/GRPC defaults.
      Used to implement `//CC/proto:defaults` for CC proto libraries
      and `//CC/proto:service defaults` for CC proto service libraries
      (GRPC).
    |||,
    target_fields: ['base', 'toolchain', 'deps'],
    string_fields: [
      'PROTOC',
      'PROTOCFLAGS',
      'ADD_PROTOCFLAGS',
      'LDFLAGS',
      'ADD_LDFLAGS',
      'GRPC_PLUGIN',
      'PATH',
    ],
    config_vars: ['ARCH', 'HOST_ARCH', 'DEBUG'],
    field_doc: {
      base: |||
        Other targets (using the same rule) to inherit values from. If
        multiple targets are specified, for values that are overwritten (see
        documentation of other fields) the last specified value wins.
      |||,
      toolchain: |||
        Optional toolchain directory. A collection of artifacts that provide
        the protobuf compiler and the GRPC plugin (if needed). Note that only
        artifacts of the specified targets are considered (no runfiles etc.).
        Specifying this field extends artifacts from `base`.
      |||,
      deps: |||
        Optional CC libraries the resulting CC proto libraries implicitly
        depend on. Those are typically `'libprotobuf'` for CC proto libraries
        and `'libgrpc++'` for CC proto service libraries. Specifying this
        field extends dependencies from `base`.
      |||,
      PROTOC: |||
        The proto compiler. If `toolchain` is empty, this field's value is
        considered the proto compiler name that is looked up in `PATH`. If
        `toolchain` is non-empty, this field's value is assumed to be the
        relative path to the proto compiler in `toolchain`. Specifying this
        field overwrites values from `base`.
      |||,
      GRPC_PLUGIN: |||
        The GRPC plugin for the proto compiler. If `toolchain` is empty,
        this field's value is considered to be the absolute system path to the
        plugin. If `toolchain` is non-empty, this field's value is assumed
        to be the relative path to the plugin in `toolchain`. Specifying
        this field overwrites values from `base`.
      |||,
      PROTOCFLAGS: |||
        Protobuf compiler flags. Specifying this field overwrites values from
        `base`.
      |||,
      ADD_PROTOCFLAGS: |||
        Additional protobuf compiler flags. Specifying this field extends
        values from `base`.
      |||,
      LDFLAGS: |||
        Linker flags for linking the final CC library. Specifying this field
        overwrites values from `base`.
      |||,
      ADD_LDFLAGS: |||
        Additional linker flags for linking the final CC library. Specifying
        this field extends values from `base`.
      |||,
      PATH: |||
        Path for looking up the proto compiler. Individual paths are joined
        with `':'`. Specifying this field extends values from `base`.
      |||,
    },
    config_doc: {
      ARCH: |||
        The unqualified architecture. Is taken as a default for `HOST_ARCH`
        and `TARGET_ARCH` if not set.
      |||,
      HOST_ARCH: 'The architecture on which the build actions are carried out.',
      DEBUG: |||
        If logically true (typically, a non-empty map), use debug-related
        options, otherwise not.
      |||,
    },
    config_transitions: {
      toolchain: [transitions.for_host()],
    },
    expression:
      local protoc_tool = get_field('PROTOC', cc.defaults_base_provides(provider='PROTOC'));
      local grpc_plugin_tool = get_field('GRPC_PLUGIN', cc.defaults_base_provides(provider='GRPC_PLUGIN'));
      local ldflags = get_field('LDFLAGS', cc.defaults_base_provides__concat(provider='LDFLAGS'));
      local protocflags = get_field('PROTOCFLAGS', cc.defaults_base_provides__concat(provider='PROTOCFLAGS'));
      local path = jst.nub_left(
        jst.field('PATH')
        + cc.defaults_base_provides__concat(provider='PATH'),
      );
      local env = cc.defaults_base_provides(provider='ENV', default={});
      local non_system_tools = jst.union(
        jst.flatten(
          [
            [cc.defaults_base_provides(
              provider='NON_SYSTEM_TOOLS',
              default={},
            )],
            if jst.field('PROTOC') then
              [{PROTOC: if jst.field('toolchain') then true else false}],
            if jst.field('GRPC_PLUGIN') then
              [{GRPC_PLUGIN: if jst.field('toolchain') then true else false}],
          ],
        ),
      );
      local toolchain = jst.union(
        cc.defaults_base_provides_list(provider='TOOLCHAIN', default={})
        + (if jst.field('toolchain') then
          common.field_artifacts_list(
            fieldname='toolchain',
            transition=transitions.for_host(),
          )),
        disjoint=true,
        msg='toolchain artifacts may not overlap',
      );
      local protocflags = protocflags + jst.field('ADD_PROTOCFLAGS');
      local ldflags = ldflags + jst.field('ADD_LDFLAGS');
      local deps_fieldnames = ['base', 'deps'];
      local compile_deps = cc.compile_deps(deps_fieldnames=deps_fieldnames);
      local compile_args = cc.compile_args_deps(
        deps_fieldnames=deps_fieldnames,
      );
      local link_deps = cc.link_deps(deps_fieldnames=deps_fieldnames);
      local link_args = cc.link_args_deps(deps_fieldnames=deps_fieldnames);
      local run_libs = cc.run_libs_deps(deps_fieldnames=deps_fieldnames);
      local run_libs_args = cc.run_libs_args_deps(
        deps_fieldnames=deps_fieldnames,
      );
      local cflags_files = cc.cflags_files_deps(
        deps_fieldnames=deps_fieldnames,
      );
      local ldflags_files = cc.ldflags_files_deps(
        deps_fieldnames=deps_fieldnames,
      );
      local package = {
        'cflags-files': cflags_files,
        'ldflags-files': ldflags_files,
      };
      local debug_srcs =
        if $DEBUG then
          cc.debug_deps(
            deps_provider='debug-srcs',
            deps_fieldnames=deps_fieldnames,
          )
        else
          {};
      local debug_hdrs =
        if $DEBUG then
          cc.debug_deps(
            deps_provider='debug-hdrs',
            deps_fieldnames=deps_fieldnames,
            modified_transitions=jst.env('modified-transitions', default={}),
          )
          + compile_deps
        else
          {};
      jst.result(
        provides={
          PROTOC: protoc_tool,
          PROTOCFLAGS: protocflags,
          LDFLAGS: ldflags,
          GRPC_PLUGIN: grpc_plugin_tool,
          PATH: path,
          ENV: env,
          TOOLCHAIN: toolchain,
          NON_SYSTEM_TOOLS: non_system_tools,
          'compile-deps': compile_deps,
          'compile-args': compile_args,
          'link-deps': link_deps,
          'link-args': link_args,
          'run-libs': run_libs,
          'run-libs-args': run_libs_args,
          package: package,
          'debug-srcs': debug_srcs,
          'debug-hdrs': debug_hdrs,
        },
      ),
  },

  library: {
    doc: |||
      A C++ library, generated from proto files.

      This rule usually is used to bind anonymous targets generated from
      proto libraries.
    |||,
    string_fields: ['name', 'stage'],
    target_fields: ['srcs', 'deps'],
    config_vars: ['CXX', 'CXXFLAGS', 'ADD_CXXFLAGS', 'AR', 'ENV', 'DEBUG'],
    implicit: {defaults: ['./..:defaults'], 'proto-defaults': ['defaults']},
    expression:
      local name = jst.join(jst.field('name'));
      local stage = jst.join(jst.field('stage'), sep='/');
      cc_proto.protoc_compile(
        name=name,
        stage=stage,
        public_fieldnames=['deps', 'proto-defaults', 'defaults'],
        private_fieldnames=['deps', 'proto-defaults', 'defaults'],
        lint_deps_fieldnames=['deps'],
      ),
  },

  'service library': {
    doc: |||
      A service C++ library, generated from proto files.

      Calls protoc with gRPC plugin to additionally generate gRPC services
      from proto libraries.
    |||,
    string_fields: ['name', 'stage'],
    target_fields: ['srcs', 'deps'],
    config_vars: ['CXX', 'CXXFLAGS', 'ADD_CXXFLAGS', 'AR', 'ENV', 'DEBUG'],
    implicit: {
      defaults: ['./..:defaults'],
      'proto-defaults': ['service defaults'],
    },
    expression:
      local name = jst.join(jst.field('name'));
      local stage = jst.join(jst.field('stage'), sep='/');
      cc_proto.protoc_compile(
        name=name,
        stage=stage,
        service_support=true,
        public_fieldnames=['deps', 'proto-defaults', 'defaults'],
        private_fieldnames=['deps', 'proto-defaults', 'defaults'],
        lint_deps_fieldnames=['deps'],
      ),
  },
}
