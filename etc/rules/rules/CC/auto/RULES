local common = import '//expressions.jst';
local cc = import '//CC/expressions.jst';
local shell = import '//shell/expressions.jst';

{
  config: {
    doc: |||
      Generate a C/C++ config header

      Generate a C/C++ configuration header using defines specified via the
      target configuration. In the usual case, a target using this rule is
      configured by depending on it from a target that uses the built-in
      `configure` rule.
    |||,
    field_doc: {
      name: 'Name of the header file to generate (incl. file name ext).',
      guard: "The include guard. Multiple segments are joined with `'_'`.",
      stage: "The location of the header. Path segments are joined with `'/'`.",
      hdrs: |||
        Additional header files to be available in the include path. Useful
        for providing additional header files to values given in
        `have_{cfile,cxxfile,ctype,cxxtype,csymbol,cxxsymbol}`.
      |||,
      deps: |||
        Additional public header files from targets to be available in the
        include path. Useful for providing additional header files to values
        given in `have_{cfile,cxxfile,ctype,cxxtype,csymbol,cxxsymbol}`.
      |||,
      defaults: 'The C/C++ toolchain to use',
      'shell defaults': 'The shell toolchain to use',
    },
    config_doc: {
      CC: |||
        The name of the C compiler to be used by checks. If None, the
        respective value from `//CC:defaults` will be taken.
      |||,
      CXX: |||
        The name of the C++ compiler to be used by checks. If None, the
        respective value from `//CC:defaults` will be taken.
      |||,
      CFLAGS: |||
        The flags for CXX to be used instead of the default ones
        taken from the `//CC:defaults` target
      |||,
      CXXFLAGS: |||
        The flags for CXX to be used instead of the default ones
        taken from the `//CC:defaults` target
      |||,
      ADD_CFLAGS: |||
        The flags to add to the default ones for CC
        taken from the `//CC:defaults` target
      |||,
      ADD_CXXFLAGS: |||
        The flags to add to the default ones for CXX
        taken from the `//CC:defaults` target
      |||,
      ENV: 'The environment for running file/symbol/type/size checks.',
      defines: |||
        Set a define to a specific value unless its value is `'null'`. Must
        contain a list of pairs. The first element of each pair is the define
        name and the second argument is the value to set. Strings must be
        properly escaped. Defines generated from this field are added last,
        so that they can refer to defines from other `defines*`,
        `have_*`, and `size_*` values.
      |||,
      defines1: |||
        Set a define to `'1'` unless its value is untrue. Must contain a list
        of pairs. The first element of each pair is the define name and the
        second argument is the value.
      |||,
      defines01: |||
        Set a define to `'0'` or `'1'` depending on its value being true.
        Must contain a list of pairs. The first element of each pair is the
        define name and the second argument is the value.
      |||,
      have_cfile: |||
        Set a define to `'1'` if the specified C header is in the include
        path. Must contain a list of pairs. The first element of each pair is
        the define name and the second argument is the C header file name.
      |||,
      have_cxxfile: |||
        Set a define to `'1'` if the specified C++ header is in the include
        path. Must contain a list of pairs. The first element of each pair is
        the define name and the second argument is the C++ header file name.
      |||,
      have_ctype: |||
        Set a define to `'1'` if the specified C type is defined. Must
        contain a list of pairs. The first element of each pair is the define
        name and the second argument is name of the C type. If the specified
        C type is not a built-in type, additionally the headers
        `'sys/types.h'`, `'stdint.h'`, and `'stddef.h'` are checked as well.
      |||,
      have_cxxtype: |||
        Set a define to `'1'` if the specified C++ type is defined. Must
        contain a list of pairs. The first element of each pair is the define
        name and the second argument is name of the C++ type. If the specified
        C++ type is not a built-in type, additionally the headers
        `'sys/types.h'`, `'stdint.h'`, and `'stddef.h'` are checked as well.
      |||,
      have_csymbol: |||
        Set a define to `'1'` if the specified C symbol is defined by one of
        the specified headers in the include path. Must contain a list of
        pairs. The first element of each pair is the define name and the
        second argument is another pair. This pair's first value is the C
        symbol to search for and the second value is a list with the header
        file names to consider for searching. If the header file defines the
        symbol as a macro it is considered available and assumed to work.
      |||,
      have_cxxsymbol: |||
        Set a define to `'1'` if the specified C++ symbol is defined by one of
        the specified headers in the include path. Must contain a list of
        pairs. The first element of each pair is the define name and the
        second argument is another pair. This pair's first value is the C++
        symbol to search for and the second value is a list with the header
        file names to consider for searching. If the header file defines the
        symbol as a macro it is considered available and assumed to work.
      |||,
      size_ctype: |||
        Set a define to size of the specified C type. Must contain a list of
        pairs. The first element of each pair is the define name and the
        second argument is another pair. This pair's first value is the C
        type to check for and the second value is a list with possible sizes
        as numbers. If none of the specified sizes matches, the action fails.
      |||,
      size_cxxtype: |||
        Set a define to size of the specified C++ type. Must contain a list of
        pairs. The first element of each pair is the define name and the
        second argument is another pair. This pair's first value is the C++
        type to check for and the second value is a list with possible sizes
        as numbers. If none of the specified sizes matches, the action fails.
      |||,
    },
    string_fields: ['name', 'stage', 'guard'],
    target_fields: ['hdrs', 'deps'],
    config_vars: [
      'CC',
      'CXX',
      'CFLAGS',
      'CXXFLAGS',
      'ADD_CFLAGS',
      'ADD_CXXFLAGS',
      'ENV',
      'defines',
      'defines1',
      'defines01',
      'have_cfile',
      'have_cxxfile',
      'have_ctype',
      'have_cxxtype',
      'have_csymbol',
      'have_cxxsymbol',
      'size_ctype',
      'size_cxxtype',
    ],
    implicit: {
      defaults: ['./..:defaults'],
      'shell defaults': ['./../../shell:defaults'],
    },
    expression:
      local name = jst.join(jst.field('name'));
      local stage = jst.join(jst.field('stage'), sep='/');
      local guard = jst.assert_non_empty(
        jst.join(jst.field('guard'), sep='_'),
        msg='Config header include guard may not be empty',
      );
      local includes = jst.to_subdir(
        jst.union(
          [
            common.field_artifacts(fieldname='hdrs'),
            cc.compile_deps(deps_fieldnames=['deps']),
          ],
          disjoint=true,
          msg='Includes may not overlap',
        ),
        subdir='include',
      );
      local toolchain_dir = 'toolchain';
      local toolchain = cc.default_toolchain();
      local shell_toolchain = common.field_map_provider(
        fieldname='shell defaults',
        provider='TOOLCHAIN',
      );
      local toolchain = jst.union(
        [toolchain, shell_toolchain],
        disjoint=true,
        msg='Shell and CC toolchain must not conflict',
      );
      local toolchain = jst.to_subdir(toolchain, subdir=toolchain_dir);
      local sh = shell.sh(
        toolchain_dir=toolchain_dir,
        fieldname='shell defaults',
      );
      local bin_dirs = common.field_list_provider(
        fieldname='shell defaults',
        provider='bin dirs',
      );
      local bin_dirs = [
        jst.join(['./', toolchain_dir, '/', it])
        for it in bin_dirs
      ];
      local non_system_tools = cc.default_non_system_tools();
      local cc_tool = cc.compiler_cc(
        toolchain_dir=toolchain_dir,
        non_system_tools=non_system_tools,
      );
      local cxx_tool = cc.compiler_cxx(
        toolchain_dir=toolchain_dir,
        non_system_tools=non_system_tools,
      );
      local cflags = cc.flags_cc(
        build_position_independent=$BUILD_POSITION_INDEPENDENT,
      );
      local cxxflags = cc.flags_cxx(
        build_position_independent=$BUILD_POSITION_INDEPENDENT,
      );
      local env = cc.default_env()
      + jst.env('ENV', default={});
      local env_path = jst.get('PATH', env);
      local env =
        env
        + {
          PATH: jst.join(
            jst.flatten(
              [
                cc.default_path(),
                if env_path then [env_path],
                shell.path(fieldname='shell defaults'),
                bin_dirs,
              ],
            ),
            sep=':',
          ),
        };
      local c_flags = jst.make_blob(jst.join(cflags, sep='\n'));
      local cxx_flags = jst.make_blob(jst.join(cxxflags, sep='\n'));
      local file_check_sh = jst.make_blob(
        jst.join(
          [
            'set -eu',
            '[ $# -ge 4 ]',
            'CC=$1',
            'LANG=$2',
            'DEF=$3',
            'HDR=$4',
            'DEFINE="/* #undef $DEF */"',
            'echo "#include \\"$HDR\\"" > test.$LANG',
            'if $CC @$LANG.flags -c test.$LANG -I ./include 2>/dev/null; then DEFINE="#define $DEF 1"; fi',
            'echo "$DEFINE\n" > out.def',
          ],
          sep='\n',
        ),
      );
      local type_check_sh = jst.make_blob(
        jst.join(
          [
            'set -eu',
            '[ $# -ge 4 ]',
            'CC=$1',
            'LANG=$2',
            'DEF=$3',
            'TYPE=$4',
            'INC=""',
            'DEFINE="/* #undef $DEF */"',
            'for HDR in "" "sys/types.h" "stdint.h" "stddef.h"; do',
            '  if [ -n "$HDR" ]; then INC="#include \\"$HDR\\""; fi',
            '  cat > test.$LANG << EOF',
            '$INC',
            '$TYPE* __test;',
            'EOF',
            '  if $CC @$LANG.flags -c test.$LANG -I ./include 2>/dev/null; then',
            '    DEFINE="#define $DEF 1"',
            '    break',
            '  fi',
            'done',
            'echo "$DEFINE\n" > out.def',
          ],
          sep='\n',
        ),
      );
      local symbol_check_sh = jst.make_blob(
        jst.join(
          [
            'set -eu',
            '[ $# -ge 4 ]',
            'CC=$1',
            'shift',
            'LANG=$1',
            'shift',
            'DEF=$1',
            'shift',
            'SYMBOL=$1',
            'shift',
            'DEFINE="/* #undef $DEF */"',
            'for INC in "$@"; do',
            '  cat > test_symbol.$LANG << EOF',
            '#include "$INC"',
            'void* __test = &$SYMBOL;',
            'EOF',
            '  if $CC @$LANG.flags -c test_symbol.$LANG -I ./include 2>/dev/null; then',
            '    DEFINE="#define $DEF 1"',
            '    break',
            '  fi',
            '  cat > test_macro.$LANG << EOF',
            '#include "$INC"',
            '#ifndef $SYMBOL',
            '#error not defined as macro',
            '#endif',
            'EOF',
            '  if $CC @$LANG.flags -c test_macro.$LANG -I ./include 2>/dev/null; then',
            '    DEFINE="#define $DEF 1"',
            '    break',
            '  fi',
            'done',
            'echo "$DEFINE\n" > out.def',
          ],
          sep='\n',
        ),
      );
      local size_check_sh = jst.make_blob(
        jst.join(
          [
            'set -eu',
            '[ $# -ge 4 ]',
            'CC=$1',
            'shift',
            'LANG=$1',
            'shift',
            'DEF=$1',
            'shift',
            'TYPE=$1',
            'shift',
            'INC=""',
            'for HDR in "" "sys/types.h" "stdint.h" "stddef.h"; do',
            '  if [ -n "$HDR" ]; then INC="#include \\"$HDR\\""; fi',
            '  for SIZE in "$@"; do',
            '    SIZE=$(printf %.0f $SIZE)',
            '    cat > test.$LANG << EOF',
            '$INC',
            'char __test[(sizeof($TYPE) == $SIZE) ? 1 : -1];',
            'EOF',
            '    if $CC @$LANG.flags -c test.$LANG -I ./include 2>/dev/null; then',
            '      DEFINE="#define $DEF $SIZE"',
            '      echo "$DEFINE\n" > out.def',
            '      exit 0',
            '    fi',
            '  done',
            'done',
            'exit 1',
          ],
          sep='\n',
        ),
      );
      local guard_def = jst.make_blob(
        jst.join(
          [
            jst.join(['#ifndef', guard], sep=' '),
            jst.join(['#define', guard], sep=' '),
            '\n\n',
          ],
          sep='\n',
        ),
      );
      local plain_def = jst.make_blob(
        jst.join(
          [
            local def = jst.assert_non_empty(
              jst.at(0, pair),
              msg='Define name in \'defines\' may not be empty',
            );
            local val = jst.at(-1, pair);
            jst.join(
              if val == null then
                ['/* #undef', def, '*/\n\n']
              else
                ['#define', def, val + '\n\n'],
              sep=' ',
            )
            for pair in jst.env('defines', default=[])
          ],
        ),
      );
      local int1_def = jst.make_blob(
        jst.join(
          [
            local def = jst.assert_non_empty(
              jst.at(0, pair),
              msg='Define name in \'defines1\' may not be empty',
            );
            local val = jst.at(-1, pair);
            jst.join(
              if val then
                ['#define', def, '1\n\n']
              else
                ['/* #undef', def, '*/\n\n'],
              sep=' ',
            )
            for pair in jst.env('defines1', default=[])
          ],
        ),
      );
      local int01_def = jst.make_blob(
        jst.join(
          [
            local def = jst.assert_non_empty(
              jst.at(0, pair),
              msg='Define name in \'defines01\' may not be empty',
            );
            local val = jst.at(-1, pair);
            jst.join(
              ['#define', def, if val then '1\n\n' else '0\n\n'],
              sep=' ',
            )
            for pair in jst.env('defines01', default=[])
          ],
        ),
      );
      local cfile_defs = [
        local def = jst.assert_non_empty(
          jst.at(0, pair),
          msg='Define name in \'have_cfile\' may not be empty',
        );
        local val = jst.at(-1, pair);
        jst.get(
          'out.def',
          jst.action(
            inputs=jst.union(
              [
                toolchain,
                {'file_check.sh': file_check_sh, 'c.flags': c_flags},
                includes,
              ],
            ),
            cmd=[sh, './file_check.sh', cc_tool, 'c', def, val],
            outs=['out.def'],
            env=env,
            label='Auto-config ' + def,
          ),
        )
        for pair in jst.env('have_cfile', default=[])
      ];
      local cxxfile_defs = [
        local def = jst.assert_non_empty(
          jst.at(0, pair),
          msg='Define name in \'have_cxxfile\' may not be empty',
        );
        local val = jst.at(-1, pair);
        jst.get(
          'out.def',
          jst.action(
            inputs=jst.union(
              [
                toolchain,
                {'file_check.sh': file_check_sh, 'cxx.flags': cxx_flags},
                includes,
              ],
            ),
            cmd=[sh, './file_check.sh', cxx_tool, 'cxx', def, val],
            outs=['out.def'],
            env=env,
            label='Auto-config ' + def,
          ),
        )
        for pair in jst.env('have_cxxfile', default=[])
      ];
      local ctype_defs = [
        local def = jst.assert_non_empty(
          jst.at(0, pair),
          msg='Define name in \'have_ctype\' may not be empty',
        );
        local type = jst.at(-1, pair);
        jst.get(
          'out.def',
          jst.action(
            inputs=jst.union(
              [
                toolchain,
                {'type_check.sh': type_check_sh, 'c.flags': c_flags},
                includes,
              ],
            ),
            cmd=[sh, './type_check.sh', cc_tool, 'c', def, type],
            outs=['out.def'],
            env=env,
            label='Auto-config ' + def,
          ),
        )
        for pair in jst.env('have_ctype', default=[])
      ];
      local cxxtype_defs = [
        local def = jst.assert_non_empty(
          jst.at(0, pair),
          msg='Define name in \'have_cxxtype\' may not be empty',
        );
        local type = jst.at(-1, pair);
        jst.get(
          'out.def',
          jst.action(
            inputs=jst.union(
              [
                toolchain,
                {'type_check.sh': type_check_sh, 'cxx.flags': cxx_flags},
                includes,
              ],
            ),
            cmd=[sh, './type_check.sh', cxx_tool, 'cxx', def, type],
            outs=['out.def'],
            env=env,
            label='Auto-config ' + def,
          ),
        )
        for pair in jst.env('have_cxxtype', default=[])
      ];
      local csymbol_defs = [
        local def = jst.assert_non_empty(
          jst.at(0, pair),
          msg='Define name in \'have_csymbol\' may not be empty',
        );
        local sym_hdrs = jst.at(-1, pair);
        local sym = jst.at(0, sym_hdrs);
        local hdrs = jst.at(-1, sym_hdrs);
        jst.get(
          'out.def',
          jst.action(
            inputs=jst.union(
              [
                toolchain,
                {'symbol_check.sh': symbol_check_sh, 'c.flags': c_flags},
                includes,
              ],
            ),
            cmd=[sh, './symbol_check.sh', cc_tool, 'c', def, sym] + hdrs,
            outs=['out.def'],
            env=env,
            label='Auto-config ' + def,
          ),
        )
        for pair in jst.env('have_csymbol', default=[])
      ];
      local cxxsymbol_defs = [
        local def = jst.assert_non_empty(
          jst.at(0, pair),
          msg='Define name in \'have_csymbol\' may not be empty',
        );
        local sym_hdrs = jst.at(-1, pair);
        local sym = jst.at(0, sym_hdrs);
        local hdrs = jst.at(-1, sym_hdrs);
        jst.get(
          'out.def',
          jst.action(
            inputs=jst.union(
              [
                toolchain,
                {'symbol_check.sh': symbol_check_sh, 'cxx.flags': cxx_flags},
                includes,
              ],
            ),
            cmd=[sh, './symbol_check.sh', cxx_tool, 'cxx', def, sym] + hdrs,
            outs=['out.def'],
            env=env,
            label='Auto-config ' + def,
          ),
        )
        for pair in jst.env('have_cxxsymbol', default=[])
      ];
      local csize_defs = [
        local def = jst.assert_non_empty(
          jst.at(0, pair),
          msg='Define name in \'have_csymbol\' may not be empty',
        );
        local type_sizes = jst.at(-1, pair);
        local type = jst.at(0, type_sizes);
        local sizes = jst.at(-1, type_sizes);
        jst.get(
          'out.def',
          jst.action(
            inputs=jst.union(
              [
                toolchain,
                {'size_check.sh': size_check_sh, 'c.flags': c_flags},
                includes,
              ],
            ),
            cmd=[sh, './size_check.sh', cc_tool, 'c', def, type]
            + [jst.json_encode(size) for size in sizes],
            outs=['out.def'],
            env=env,
            label='Auto-config ' + def,
          ),
        )
        for pair in jst.env('size_ctype', default=[])
      ];
      local cxxsize_defs = [
        local def = jst.assert_non_empty(
          jst.at(0, pair),
          msg='Define name in \'have_csymbol\' may not be empty',
        );
        local type_sizes = jst.at(-1, pair);
        local type = jst.at(0, type_sizes);
        local sizes = jst.at(-1, type_sizes);
        jst.get(
          'out.def',
          jst.action(
            inputs=jst.union(
              [
                toolchain,
                {'size_check.sh': size_check_sh, 'cxx.flags': cxx_flags},
                includes,
              ],
            ),
            cmd=[sh, './size_check.sh', cxx_tool, 'cxx', def, type]
            + [jst.json_encode(size) for size in sizes],
            outs=['out.def'],
            env=env,
            label='Auto-config ' + def,
          ),
        )
        for pair in jst.env('size_cxxtype', default=[])
      ];
      local end_def = jst.make_blob('\n#endif\n');
      local definitions = jst.enumerate(
        jst.flatten(
          [
            [guard_def, int1_def, int01_def],
            cfile_defs,
            cxxfile_defs,
            ctype_defs,
            cxxtype_defs,
            csymbol_defs,
            cxxsymbol_defs,
            csize_defs,
            cxxsize_defs,
            [plain_def, end_def],
          ],
        ),
      );
      local outfile = jst.action(
        inputs=toolchain + definitions,
        cmd=[
          sh,
          '-c',
          jst.join(
            ['cat', jst.join_cmd(jst.keys(definitions)), '> out'],
            sep=' ',
          ),
        ],
        outs=['out'],
        env=env,
        label='Auto-config generate ' + name,
      );
      local outfile = jst.to_subdir(
        {[name]: jst.get('out', outfile)},
        subdir=stage,
      );
      jst.result(artifacts=outfile, runfiles=outfile),
  },

  config_file: {
    doc: |||
      Generate a C/C++ config header from a given template

      Generate a C/C++ configuration header using defines specified via the
      target configuration. In the usual case, a target using this rule is
      configured by depending on it from a target that uses the built-in
      `configure` rule.

      The actual generation of the header file from the template
      is done by the implicit dependency on the `runner` target which
      can be changed globally by setting this target in the
      target layer of this repository.
    |||,
    field_doc: {
      output: |||
        Name of the header file to generate (incl. file name ext). Components
        are joined with /.
      |||,
      input: 'The input configuration file, used as template.',
      magic_string: |||
        The magic string (e.g., `'cmakedefine'`) which identifies in which line
        we have to `'#define'` or `'#undef'` variables according to what is
        defined in the config field `defines`.
      |||,
      '@only': 'If set, only replace `@VAR@` and not `${VAR}`',
      runner: 'The program generating the header file from the template.',
    },
    config_doc: {
      defines: |||
        Set a define to a specific value unless its value is `'null'`. Must
        contain a list of pairs. The first element of each pair is the define
        name and the second argument is the value to set. Strings must be
        properly escaped. Defines generated from this field are added last,
        so that they can refer to defines from other `defines*` values.
      |||,
    },
    string_fields: ['magic_string', '@only', 'output'],
    target_fields: ['input'],
    config_vars: ['defines'],
    implicit: {runner: ['runner'], defaults: ['./..:defaults']},
    expression:
      local runner = common.stage_singleton_field(
        fieldname='runner',
        location='runner',
      );
      local dict_defines = jst.union(
        [
          local key = jst.at(0, pair);
          local val = jst.at(-1, pair);
          {[key]: val}
          for pair in jst.env('defines', default=[])
        ],
      );
      local magic_string = jst.assert_non_empty(
        jst.join(jst.field('magic_string')),
        msg='A non-empty string has to be provided for magic_string',
      );
      local only = if jst.field('@only') then 'true' else 'false';
      local param_blob = {
        'param-file': jst.make_blob(jst.json_encode(dict_defines)),
      };
      local input_blob = common.stage_singleton_field(
        fieldname='input',
        location='input-file',
      );
      local path = cc.default_path();
      local env = if path then {PATH: jst.join(path, sep=':')} else {};
      local outname = jst.join(jst.field('output'), sep='/');
      local outfile = jst.action(
        inputs=jst.union([param_blob, input_blob, runner]),
        cmd=['./runner', 'input-file', 'param-file', magic_string, only],
        outs=['out'],
        env=env,
        label='Generating config ' + jst.basename(outname),
      );
      local outfile = {[outname]: jst.get('out', outfile)};
      jst.result(artifacts=outfile, runfiles=outfile),
  },
}
