local common = import '//expressions.jst';
local cc = import '//CC/expressions.jst';
local shell = import '//shell/expressions.jst';
local transitions = import '//transitions/expressions.jst';

{
  defaults: {
    doc: |||
      A rule to provide defaults for the usage of the shell

      All targets using invocations of the shell use the target
      `//shell:defaults` to determine which shell to use and how to
      invoke it. The definition of this default target is probably the only
      meaningful use of this rule.
    |||,
    target_fields: ['base', 'toolchain'],
    string_fields: ['sh', 'PATH', 'bin dirs'],
    field_doc: {
      base: 'Other targets (using the same rule) to inherit values from.',
      toolchain: |||
        Optional toolchain directory. A collection of artifacts that
        form the toolchain, in particular the shell itself, where not taken
        from the ambient host environment.
        Values provided from base are extended.
        This field is built for the host.
      |||,
      sh: |||
        The name of the sh binary; if the the field `toolchain` is
        not empty, the value is interpreted as relative to the toolchain
        directory.
      |||,
      PATH: |||
        Paths for looking up system tools.
        Specifying this field extends values from `base`.
      |||,
      'bin dirs': |||
        Directories of the toolchain that contain additional binaries.
        Shell-specific rules will add those into PATH.
      |||,
    },
    config_vars: ['ARCH', 'HOST_ARCH', 'TARGET_ARCH'],
    config_transitions: {
      toolchain: [transitions.for_host()],
    },
    expression:
      local toolchain = jst.union(
        cc.defaults_base_provides_list(provider='TOOLCHAIN', default={})
        + (
          common.field_artifacts_list(
            fieldname='toolchain',
            transition=transitions.for_host(),
          )
        ),
        disjoint=true,
        msg='toolchain artifacts must not overlap',
      );
      local sh =
        if jst.field('sh') then
          jst.field('sh')
        else
          cc.defaults_base_provides(provider='sh');
      local non_system_tools = jst.union(
        [
          cc.defaults_base_provides(provider='NON_SYSTEM_TOOLS', default={}),
        ]
        + (if jst.field('sh') then
          [{sh: if jst.field('toolchain') then true else false}]),
      );
      local path = jst.nub_left(
        jst.field('PATH')
        + cc.defaults_base_provides__concat(provider='PATH'),
      );
      local bin_dirs = jst.nub_left(
        jst.field('bin dirs')
        + cc.defaults_base_provides__concat(provider='bin dirs'),
      );
      jst.result(
        provides={
          TOOLCHAIN: toolchain,
          sh: sh,
          NON_SYSTEM_TOOLS: non_system_tools,
          PATH: path,
          'bin dirs': bin_dirs,
        },
      ),
  },

  cmds: {
    doc: |||
      Execute commands using the shell

      This rule behaves similar to the built-in `generic` rule, however
      with the difference that the shell toolchain is honored.
    |||,
    target_fields: ['deps'],
    string_fields: ['cmds', 'outs', 'out_dirs'],
    implicit: {defaults: ['defaults']},
    field_doc: {
      deps: |||
        Any  inputs to the argument.
        Both, artifacts and runfiles of the dependencies are staged into
        the (effective) working directory of the action. Conflicts are
        resolved by giving artifacts priority to runfiles, and within
        each of those priority to ones brought by the latest dependency.
      |||,
      cmds: |||
        The command to be executed.
        Individual entries are joined by newline characters; the whole
        script is then prefixed by commands necessary to set up the
        work environment using the shell toolchain.
      |||,
      defaults: 'The shell toolchain to use.',
      outs: 'The expected file outputs',
      out_dirs: 'The expected output directories',
    },
    expression:
      local fieldname = 'deps';
      local deps = jst.union(
        common.field_runfiles_list(fieldname=fieldname)
        + common.field_artifacts_list(fieldname=fieldname),
      );
      local fieldname = 'defaults';
      local toolchain_dir = 'toolchain';
      local toolchain = jst.to_subdir(
        common.field_map_provider(fieldname=fieldname, provider='TOOLCHAIN'),
        subdir=toolchain_dir,
      );
      local wrkdir = 'work';
      local cmds = jst.flatten(
        [
          shell.prolog(fieldname=fieldname, toolchain_dir=toolchain_dir),
          [jst.join_cmd(['cd', wrkdir])],
          jst.field('cmds'),
        ],
      );
      local sh = shell.sh(toolchain_dir=toolchain_dir, fieldname=fieldname);
      local cmdfile = {cmd: jst.make_blob(jst.join(cmds, sep='\n'))};
      local path = shell.path(fieldname=fieldname);
      local env = if path then {PATH: jst.join(path, sep=':')} else {};
      local outs_in_wrkdir = [
        jst.join([wrkdir, '/', it])
        for it in jst.field('outs')
      ];
      local out_dirs_in_wrkdir = [
        jst.join([wrkdir, '/', it])
        for it in jst.field('out_dirs')
      ];
      local artifacts = jst.action(
        inputs=jst.union(
          [toolchain, cmdfile, jst.to_subdir(deps, subdir=wrkdir)],
        ),
        cmd=[sh, 'cmd'],
        outs=outs_in_wrkdir,
        out_dirs=out_dirs_in_wrkdir,
        env=env,
        label='Running shell commands',
      );
      local staged_artifacts = {
        [it]: jst.get(jst.join([wrkdir, '/', it]), artifacts)
        for it in jst.field('outs') + jst.field('out_dirs')
      };
      jst.result(artifacts=staged_artifacts),
  },
}
