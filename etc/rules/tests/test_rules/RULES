local common = import '@rules//expressions.jst';

{
  test_case: {
    doc: |||
      Define a test case for rule tests.
      The config variables "ENV", "ARCH", "HOST_ARCH", "TARGET_ARCH",
      "BUILD_ARCH", "OS" are collected in a file named "conf_vars.json".
      The test runner will pass that file as argument to "-c" to the "jst"
      binary, which is internally called.
    |||,
    string_fields: ['name', 'libs', 'targets', 'asserts'],
    target_fields: ['data'],
    field_doc: {
      name: 'Name of the test (multiple entries are joined).',
      libs: |||
        Paths to external libraries' trees provided by the "test-libs"
        repository. From within a test cases, the library's tree can be
        accessed via ["@", "<libpath>", "", "tree"].
      |||,
      targets: |||
        Target names to build and install. Each target name is prefixed by
        "+" or "-", indicating if the build should fail or not.
        Targets that build successfully will be installed to a directory
        named identical to the target name (without the prefix).
      |||,
      asserts: |||
        List of commands to execute after all targets were processed. To
        access artifacts from installed targets, use the corresponding target
        name as prefix dir (e.g., target "+foo" installs to "./foo/").
      |||,
      data: 'The directory that contains the project with the targets to test.',
    },
    tainted: ['test'],
    config_vars: [
      'ENV',
      'ARCH',
      'HOST_ARCH',
      'TARGET_ARCH',
      'BUILD_ARCH',
      'OS',
      'TOOLCHAIN_CONFIG',
    ],
    implicit: {
      runner: ['test_runner.py'],
      rules: ['@test-rules//:tree'],
      libs_tree: ['@test-libs//:tree'],
    },
    expression:
      local name = jst.join(jst.field('name'));
      local rules = common.stage_singleton_field(
        fieldname='rules',
        location='rules',
      );
      local imports = {
        'imports/TARGETS': jst.make_blob(
          '{"tree":{"type":"install","dirs":[[["TREE",null,"."],"."]]}}',
        ),
      };
      local libs = common.stage_singleton_field(
        fieldname='libs_tree',
        location='libs',
      );
      local work = common.stage_singleton_field(
        fieldname='data',
        location='work',
      );
      local runner = common.stage_singleton_field(
        fieldname='runner',
        location='runner',
      );
      local targets = jst.field('targets');
      local asserts = jst.field('asserts');
      local work_bindings = jst.union(
        [{rules: 'rules'}]
        + [{[libpath]: libpath} for libpath in jst.field('libs')],
      );
      local work_deps = jst.union(
        [{rules: {workspace_root: ['file', 'rules']}}]
        + [
          {
            [libpath]: {
              workspace_root: ['file', 'libs/' + libpath],
              target_root: ['file', 'imports'],
            },
          }
          for libpath in jst.field('libs')
        ],
      );
      local repos = {
        'repos.json': jst.make_blob(
          jst.json_encode(
            {
              main: 'work',
              repositories:
                {
                  work: {
                    workspace_root: ['file', 'work'],
                    bindings: work_bindings,
                  },
                }
                + work_deps,
            },
          ),
        ),
      };
      local config = {
        'config.json': jst.make_blob(
          jst.json_encode({targets: targets, asserts: asserts}),
        ),
      };
      local conf_vars = {
        'conf_vars.json': jst.make_blob(
          jst.json_encode(
            {
              ENV: $ENV,
              ARCH: $ARCH,
              HOST_ARCH: $HOST_ARCH,
              TARGET_ARCH: $TARGET_ARCH,
              BUILD_ARCH: $BUILD_ARCH,
              OS: $OS,
              TOOLCHAIN_CONFIG: $TOOLCHAIN_CONFIG,
            },
          ),
        ),
      };
      local results = jst.action(
        inputs=jst.union(
          [runner, rules, imports, libs, repos, work, config, conf_vars],
        ),
        outs=['stdout', 'stderr', 'result', 'time-start', 'time-stop'],
        cmd=['./runner'],
        label='Running rule test ' + name,
        may_fail=['test'],
        fail_message=jst.join(['Rule test ', name, ' failed']),
        env=jst.env('ENV', default={}),
      );
      jst.result(artifacts=results, runfiles={[name]: jst.make_tree(results)}),
  },
}
