{ "defaults":
  { "type": ["CC", "defaults"]
  , "arguments_config": ["DEBUG"]
  , "base": [["@", "toolchain", "CC", "defaults"]]
  , "ADD_CXXFLAGS":
    { "type": "++"
    , "$1":
      [ ["-std=c++20", "-Wall", "-Wextra", "-Werror", "-pedantic-errors"]
      , { "type": "if"
        , "cond": {"type": "var", "name": "DEBUG"}
        , "then": ["-O0", "-g"]
        , "else": ["-O2", "-DNDEBUG"]
        }
      ]
    }
  , "PATH": ["/bin", "/usr/bin"]
  }
}
