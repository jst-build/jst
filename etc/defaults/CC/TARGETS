{
  defaults: {
    type: @'//CC:defaults',
    arguments_config: ['DEBUG'],
    base: [@'toolchain//CC:defaults'],
    ADD_CXXFLAGS:
      [
        '-std=c++20',
        '-Wall',
        '-Wextra',
        '-Werror',
        '-pedantic-errors',
      ]
      + if jst.env('DEBUG') then
        ['-O0', '-g']
      else
        ['-O2', '-DNDEBUG'],
    PATH: [
      '/bin',
      '/usr/bin',
    ],
  },
}
