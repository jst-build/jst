{
  "main": "jst",
  "repositories": {
    "config": {
      "repository": {
        "type": "file",
        "path": "etc/config"
      }
    },
    "rules": {
      "repository": "toolchain",
      "target_root": "config",
      "rule_root": "toolchain",
      "bindings": {
        "base": "toolchain"
      }
    },
    "jst": {
      "repository": {
        "type": "file",
        "path": "."
      },
      "bindings": {
        "rules": "rules",
        "gsl": "gsl",
        "cli11": "cli11",
        "json": "json",
        "fmt": "fmt",
        "ssl": "ssl",
        "grpc": "grpc",
        "googleapis": "google_apis",
        "bazel_remote_apis": "bazel_remote_apis",
        "libgit2": "libgit2",
        "protoc": "protobuf",
        "libcurl": "curl",
        "libarchive": "libarchive",
        "justlang": "justlang"
      }
    },
    "tests": {
      "repository": {
        "type": "file",
        "path": "test"
      },
      "bindings": {
        "src": "jst",
        "rules": "rules",
        "catch2": "catch2",
        "gsl": "gsl",
        "cli11": "cli11",
        "json": "json",
        "fmt": "fmt",
        "ssl": "ssl",
        "grpc": "grpc",
        "googleapis": "google_apis",
        "bazel_remote_apis": "bazel_remote_apis",
        "libgit2": "libgit2",
        "protoc": "protobuf",
        "justlang_tests": "justlang_tests"
      }
    },
    "lint": {
      "repository": {
        "type": "file",
        "path": "lint"
      },
      "bindings": {
        "rules": "rules",
        "jst": "jst",
        "tests": "tests",
        "clang": "clang-18",
        "justlang_lint": "justlang_lint"
      }
    },
    "base_rules": {
      "repository": {
        "type": "file",
        "path": "etc/rules/rules",
        "pragma": {
          "to_git": true
        }
      }
    },
    "toolchain": {
      "repository": "base_rules",
      "target_root": "toolchain/targets",
      "rule_root": "base_rules"
    },
    "toolchain/targets": {
      "repository": {
        "type": "file",
        "path": "etc/toolchain/targets",
        "pragma": {
          "to_git": true
        }
      }
    },
    "json": {
      "repository": "fmt/imports",
      "target_file_name": "json.TARGETS",
      "bindings": {
        "rules": "toolchain"
      }
    },
    "cli11": {
      "repository": "fmt/imports",
      "target_file_name": "cli11.TARGETS",
      "bindings": {
        "rules": "toolchain"
      }
    },
    "fmt": {
      "repository": "fmt/imports",
      "target_file_name": "fmt.TARGETS",
      "bindings": {
        "rules": "toolchain"
      }
    },
    "fmt/imports": {
      "repository": {
        "type": "file",
        "path": "etc/imports/."
      }
    },
    "ssl": {
      "repository": "fmt/imports",
      "target_file_name": "ssl.TARGETS",
      "bindings": {
        "rules": "toolchain"
      }
    },
    "libgit2": {
      "repository": "fmt/imports",
      "target_file_name": "libgit2.TARGETS",
      "bindings": {
        "rules": "toolchain"
      }
    },
    "protobuf": {
      "repository": "fmt/imports",
      "target_file_name": "protobuf.TARGETS",
      "bindings": {
        "rules": "toolchain"
      }
    },
    "gsl": {
      "repository": "fmt/imports",
      "target_file_name": "gsl.TARGETS",
      "bindings": {
        "rules": "toolchain"
      }
    },
    "catch2": {
      "repository": "fmt/imports",
      "target_file_name": "catch2.TARGETS",
      "bindings": {
        "rules": "toolchain"
      }
    },
    "grpc": {
      "repository": "fmt/imports",
      "target_file_name": "grpc.TARGETS",
      "bindings": {
        "rules": "toolchain"
      }
    },
    "libarchive": {
      "repository": "fmt/imports",
      "target_file_name": "libarchive.TARGETS",
      "bindings": {
        "rules": "toolchain"
      }
    },
    "curl": {
      "repository": "fmt/imports",
      "target_file_name": "curl.TARGETS",
      "bindings": {
        "rules": "toolchain"
      }
    },
    "bazel_remote_apis": {
      "repository": {
        "type": "archive",
        "content": "b2c8d2624519413a67d354d8e2b1b707e29482b1",
        "fetch": "https://github.com/bazelbuild/remote-apis/archive/9ef19c6b5fbf77d6dd9d84d75fbb5a20a6b62ef1.tar.gz",
        "sha256": "ccf57539b6347ceb0aa7e93ee43b9fff1aeb496d36cc097da918c4a35ef65839",
        "sha512": "6fc84bc0b3f0730651ec9f7fe03e343c02acaabfef80cd3057343b6c6b935820e4fea27e0c8f0f0d86ccd9c3cbf82461e75b66740326113cf647339007fb3c0c",
        "subdir": "remote-apis-9ef19c6b5fbf77d6dd9d84d75fbb5a20a6b62ef1"
      },
      "target_root": "fmt/imports",
      "target_file_name": "bazel_remote_apis.TARGETS",
      "bindings": {
        "rules": "toolchain",
        "google_apis": "google_apis"
      }
    },
    "google_apis": {
      "repository": {
        "type": "archive",
        "content": "db3c51a8fd9c923a4e4908d8bcd7dd4642cc4664",
        "fetch": "https://github.com/googleapis/googleapis/archive/fe8ba054ad4f7eca946c2d14a63c3f07c0b586a0.tar.gz",
        "sha256": "0513f0f40af63bd05dc789cacc334ab6cec27cc89db596557cb2dfe8919463e4",
        "sha512": "d77ea83f8e68e3c0b667e7de43c2cd28b0ca7b969b2cf127b3873fc19f330ad85afb314bef4174a4e11ed68b620e43853d8b44eb833c5eca7e820ca21c1c3e15",
        "subdir": "googleapis-fe8ba054ad4f7eca946c2d14a63c3f07c0b586a0",
        "mirrors": [
          "https://storage.googleapis.com/grpc-bazel-mirror/github.com/googleapis/googleapis/archive/fe8ba054ad4f7eca946c2d14a63c3f07c0b586a0.tar.gz"
        ]
      },
      "target_root": "fmt/imports",
      "target_file_name": "google_apis.TARGETS",
      "bindings": {
        "rules": "toolchain"
      }
    },
    "clang-18": {
      "repository": {
        "type": "archive",
        "fetch": "https://github.com/llvm/llvm-project/releases/download/llvmorg-18.1.8/clang+llvm-18.1.8-x86_64-linux-gnu-ubuntu-18.04.tar.xz",
        "sha256": "54ec30358afcc9fb8aa74307db3046f5187f9fb89fb37064cdde906e062ebf36",
        "content": "495971397e90fef8f731a1f1ad3ca1d25e845b9a",
        "subdir": "clang+llvm-18.1.8-x86_64-linux-gnu-ubuntu-18.04"
      },
      "target_root": "clang-18/targets",
      "target_file_name": "clang.TARGETS",
      "bindings": {
        "rules": "clang-18/base_toolchain"
      }
    },
    "clang-18/base_toolchain": {
      "repository": "clang-18/base_toolchain/rules",
      "target_root": "clang-18/base_toolchain/targets",
      "rule_root": "clang-18/base_toolchain/rules"
    },
    "clang-18/base_toolchain/rules": {
      "repository": {
        "type": "git",
        "repository": "https://github.com/jst-build/rules-cc",
        "branch": "master",
        "commit": "9279f494cf11696d4ad28ad33480e1edfafb92c2",
        "subdir": "rules"
      }
    },
    "clang-18/base_toolchain/targets": {
      "repository": {
        "type": "git",
        "repository": "https://github.com/jst-build/toolchains-cc",
        "branch": "system",
        "commit": "c6ab89cb0f54ecf9dc7e7e37384466e81e9b09b4",
        "subdir": "targets"
      }
    },
    "clang-18/targets": {
      "repository": {
        "type": "git",
        "repository": "https://github.com/jst-build/toolchains-cc",
        "branch": "clang-amd64-gnu/v18.1.8",
        "commit": "e0b095029387ce55a5e4a890b35a8e74cf07d4f0",
        "subdir": "targets"
      }
    },
    "justlang": {
      "repository": {
        "type": "file",
        "path": "extern/justlang/."
      },
      "bindings": {
        "rules": "justlang/rules",
        "json": "json"
      }
    },
    "justlang/rules": {
      "repository": "toolchain",
      "target_root": "justlang/config",
      "rule_root": "toolchain",
      "bindings": {
        "toolchain": "toolchain"
      }
    },
    "justlang/config": {
      "repository": {
        "type": "file",
        "path": "extern/justlang/etc/config"
      }
    },
    "justlang_tests": {
      "repository": {
        "type": "file",
        "path": "extern/justlang/test"
      },
      "bindings": {
        "rules": "justlang/rules",
        "json": "json",
        "catch2": "catch2",
        "justlang": "justlang"
      }
    },
    "justlang_lint": {
      "repository": {
        "type": "file",
        "path": "extern/justlang/lint"
      },
      "bindings": {
        "rules": "justlang/rules",
        "clang": "clang-18",
        "justlang": "justlang",
        "tests": "justlang_tests"
      }
    }
  }
}