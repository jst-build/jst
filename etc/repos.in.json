{
  "main": "jst",
  "keep": ["tests", "lint"],
  "repositories": {
    "config": {"repository": {"type": "file", "path": "etc/config"}},
    "rules": {
      "repository": "toolchain",
      "target_root": "config",
      "rule_root": "toolchain",
      "bindings": {"base": "toolchain"}
    },
    "jst": {
      "repository": {"type": "file", "path": "."},
      "bindings": {
        "rules": "rules",
        "gsl": "gsl",
        "cli11": "cli11",
        "json": "json",
        "fmt": "fmt",
        "ssl": "ssl",
        "grpc": "grpc",
        "googleapis": "google_apis",
        "bazel_remote_apis": "bazel_remote_apis",
        "libgit2": "libgit2",
        "protoc": "protobuf",
        "libcurl": "curl",
        "libarchive": "libarchive",
        "justlang": "justlang"
      }
    },
    "tests": {
      "repository": {"type": "file", "path": "test"},
      "bindings": {
        "src": "jst",
        "rules": "rules",
        "catch2": "catch2",
        "gsl": "gsl",
        "cli11": "cli11",
        "json": "json",
        "fmt": "fmt",
        "ssl": "ssl",
        "grpc": "grpc",
        "googleapis": "google_apis",
        "bazel_remote_apis": "bazel_remote_apis",
        "libgit2": "libgit2",
        "protoc": "protobuf",
        "justlang_tests": "justlang_tests"
      }
    },
    "lint": {
      "repository": {"type": "file", "path": "lint"},
      "bindings": {
        "rules": "rules",
        "jst": "jst",
        "tests": "tests",
        "clang": "clang-18",
        "justlang_lint": "justlang_lint"
      }
    }
  },
  "imports": [
    {
      "source": "file",
      "path": "etc/rules",
      "repos": [{"alias": "base_rules", "pragma": {"to_git": true}}]
    },
    {
      "source": "file",
      "path": "etc/toolchain",
      "repos": [
        {
          "alias": "toolchain",
          "map": {"rules": "base_rules"},
          "pragma": {"to_git": true}
        }
      ]
    },
    {
      "source": "file",
      "path": "etc/imports",
      "repos": [
        {"repo": "json", "map": {"toolchain": "toolchain"}},
        {"repo": "cli11", "map": {"toolchain": "toolchain"}},
        {"repo": "fmt", "map": {"toolchain": "toolchain"}},
        {"repo": "ssl", "map": {"toolchain": "toolchain"}},
        {"repo": "libgit2", "map": {"toolchain": "toolchain"}},
        {"repo": "protobuf", "map": {"toolchain": "toolchain"}},
        {"repo": "gsl", "map": {"toolchain": "toolchain"}},
        {"repo": "catch2", "map": {"toolchain": "toolchain"}},
        {"repo": "grpc", "map": {"toolchain": "toolchain"}},
        {"repo": "libarchive", "map": {"toolchain": "toolchain"}},
        {"repo": "curl", "map": {"toolchain": "toolchain"}},
        {"repo": "bazel_remote_apis", "map": {"toolchain": "toolchain"}},
        {"repo": "google_apis", "map": {"toolchain": "toolchain"}}
      ]
    },
    {
      "source": "git",
      "url": "https://github.com/jst-build/toolchains-cc",
      "branch": "clang-amd64-gnu/v18.1.8",
      "repos": [{"repo": "clang", "alias": "clang-18"}]
    },
    {
      "source": "file",
      "path": "extern/justlang",
      "repos": [
        {
          "alias": "justlang",
          "map": {"toolchain": "toolchain", "json": "json"}
        },
        {
          "repo": "tests",
          "alias": "justlang_tests",
          "map": {"toolchain": "toolchain", "json": "json", "catch2": "catch2"}
        },
        {
          "repo": "lint",
          "alias": "justlang_lint",
          "map": {
            "toolchain": "toolchain",
            "json": "json",
            "catch2": "catch2",
            "clang-18": "clang-18"
          }
        }
      ]
    }
  ]
}
