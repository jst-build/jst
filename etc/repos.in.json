{ "main": "justlang"
, "imports":
  [ { "source": "git"
    , "branch": "master"
    , "url": "https://github.com/just-buildsystem/rules-cc"
    , "repos": [{"repo": "rules"}]
    }
  , { "source": "git"
    , "branch": "v1.6.0"
    , "url": "https://github.com/just-buildsystem/justbuild"
    , "repos":
      [ {"repo": "rules", "alias": "toolchain"}
      , {"repo": "json"}
      , {"repo": "catch2"}
      ]
    }
  , { "source": "git"
    , "branch": "master"
    , "url": "https://github.com/just-buildsystem/toolchains-cc.git"
    , "mirrors": ["https://gitee.com/justbuild/toolchains-cc.git"]
    , "repos":
      [{"repo": "external_clang18-x86_64-ubuntu", "alias": "clang-18"}]
    }
  ]
, "repositories":
  { "defaults": {"repository": {"type": "file", "path": "etc/defaults"}}
  , "externals": {"repository": {"type": "file", "path": "etc/externals"}}
  , "rules-justlang":
    { "repository": "toolchain"
    , "target_root": "defaults"
    , "rule_root": "toolchain"
    , "bindings": {"toolchain": "toolchain"}
    }
  , "justlang":
    { "repository": {"type": "file", "path": "."}
    , "bindings":
      {"rules": "rules-justlang", "json": "json"}
    }
  , "tests":
    { "repository": {"type": "file", "path": "test"}
    , "bindings":
      { "rules": "rules-justlang"
      , "json": "json"
      , "catch2": "catch2"
      , "justlang": "justlang"
      }
    }
  , "lint":
    { "repository": {"type": "file", "path": "lint"}
    , "bindings":
      { "rules": "rules-justlang"
      , "clang": "clang-18"
      , "justlang": "justlang"
      , "tests": "tests"
      }
    }
  }
}
