{
  "main": "stage4",
  "repositories": {
    "etc/settings": {
      "repository": {
        "type": "file",
        "path": "etc/settings"
      }
    },
    "settings": {
      "repository": "toolchain",
      "target_root": "etc/settings",
      "rule_root": "toolchain",
      "bindings": {
        "base": "toolchain"
      }
    },
    "gtest": {
      "repository": "gtest_sources",
      "target_root": "stage4",
      "target_file_name": "gtest.TARGETS",
      "bindings": {
        "rules": "toolchain"
      }
    },
    "stage4": {
      "repository": {
        "type": "file",
        "path": "."
      },
      "bindings": {
        "rules": "settings",
        "fmtlib": "fmtlib",
        "gtest": "gtest"
      }
    },
    "toolchain": {
      "repository": "toolchain/rules",
      "target_root": "toolchain/toolchain_root",
      "rule_root": "toolchain/rules",
      "target_file_name": "system.TARGETS"
    },
    "toolchain/rules": {
      "repository": {
        "type": "git",
        "repository": "https://github.com/just-buildsystem/rules-cc",
        "branch": "master",
        "commit": "457b1f9dda7366fbb4e6ac4664750bb2bab48e42",
        "subdir": "rules"
      }
    },
    "toolchain/toolchain_root": {
      "repository": {
        "type": "git",
        "repository": "https://gitee.com/justbuild/toolchains-cc.git",
        "branch": "master",
        "commit": "45a10f9ae99e175ac66d2c71fefdc5cca35f2dc4",
        "mirrors": [
          "https://github.com/just-buildsystem/toolchains-cc.git"
        ],
        "subdir": "toolchain"
      }
    },
    "fmtlib": {
      "repository": {
        "type": "zip",
        "content": "2ec6acef7f8340d6d48eee098079995a163cc388",
        "fetch": "https://github.com/fmtlib/fmt/releases/download/11.0.2/fmt-11.0.2.zip",
        "sha256": "40fc58bebcf38c759e11a7bd8fdc163507d2423ef5058bba7f26280c5b9c5465",
        "sha512": "06eba9a2a8d1c2269801e10a00ed26a9344b79bca0391a6b10f35e9716682f8345125fceb96e9ca36ffbd4c0558b0e63e4c45a9dff09a8ee186458ec68e34198",
        "subdir": "fmt-11.0.2"
      },
      "target_root": "fmtlib/import targets",
      "target_file_name": "TARGETS.fmt",
      "bindings": {
        "rules": "toolchain"
      }
    },
    "fmtlib/import targets": {
      "repository": {
        "type": "git",
        "repository": "https://github.com/just-buildsystem/justbuild.git",
        "branch": "v1.4.2",
        "commit": "7fd5d41bc219acf0d15da5dfc75d8dd4a6c53ba3",
        "mirrors": [
          "https://gitee.com/justbuild/justbuild.git"
        ],
        "subdir": "etc/import"
      }
    },
    "gtest_sources": {
      "repository": {
        "type": "git",
        "repository": "https://github.com/google/googletest.git",
        "branch": "v1.14.0",
        "commit": "f8d7d77c06936315286eb55f8de22cd23c188571",
        "mirrors": [
          "ssh://git@github.com:google/googletest.git"
        ]
      }
    }
  }
}