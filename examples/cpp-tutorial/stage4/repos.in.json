{
  "main": "stage4",
  "imports": [
    {
      "source": "git",
      "branch": "system",
      "url": "https://github.com/jst-build/toolchains-cc",
      "repos": [{"alias": "toolchain"}]
    },
    {
      "source": "git",
      "branch": "fmt/v11.2.0",
      "url": "https://github.com/jst-build/imports-cc",
      "repos": [
        {"alias": "fmtlib", "map": {"toolchain": "toolchain"}}
      ]
    },
    {
      "source": "git",
      "branch": "v1.14.0",
      "url": "https://github.com/google/googletest.git",
      "mirrors": ["ssh://git@github.com/google/googletest.git"],
      "as plain": true,
      "repos": [{"alias": "gtest_sources"}]
    }
  ],
  "repositories": {
    "config": {
      "repository": {"type": "file", "path": "config"}
    },
    "rules": {
      "repository": "toolchain",
      "target_root": "config",
      "rule_root": "toolchain",
      "bindings": {"base": "toolchain"}
    },
    "gtest": {
      "repository": "gtest_sources",
      "target_root": "stage4",
      "target_file_name": "gtest.TARGETS",
      "bindings": {"rules": "toolchain"}
    },
    "stage4": {
      "repository": {"type": "file", "path": "."},
      "bindings": {
        "rules": "rules",
        "fmtlib": "fmtlib",
        "gtest": "gtest"
      }
    }
  }
}
