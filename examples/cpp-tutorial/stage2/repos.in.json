{
  "main": "stage2",
  "imports": [{
    "source": "git",
    "branch": "system",
    "url": "https://github.com/jst-build/toolchains-cc",
    "repos": [{"alias": "toolchain"}]
  }],
  "repositories": {
    "config": {
      "repository": {"type": "file", "path": "config"}
    },
    "rules": {
      "repository": "toolchain",
      "target_root": "config",
      "rule_root": "toolchain",
      "bindings": {"base": "toolchain"}
    },
    "stage2": {
      "repository": {"type": "file", "path": "."},
      "bindings": {"rules": "rules"}
    }
  }
}
