{
  // Target 'helloworld'
  // - uses rule '//CC:binary' from binding 'rules'
  // - binary name 'helloworld'
  // - depends on module-local target 'libgreet'
  helloworld: {
    type: @'rules//CC:binary',
    name: ['helloworld'],
    srcs: ['helloworld.cpp'],
    'private-deps': [
      @':libgreet',     // same as @'//src:libgreet'
    ],
  },

  // Target 'libgreet'
  // - uses rule '//CC:library' from binding 'rules'
  // - public headers: 'greet.hpp'
  // - stage 'greet', prefix used for library artifacts and its public headers
  //   (consumers include this library via '#include "greet/greet.hpp"')
  libgreet: {
    type: @'rules//CC:library',
    name: ['greet'],    // produces libgreet.a
    hdrs: ['greet.hpp'],
    srcs: ['greet.cpp'],
    stage: ['greet'],   // prefix used for public headers
  },
}
