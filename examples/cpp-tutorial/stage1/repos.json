{
  "main": "stage1",
  "repositories": {
    "stage1": {
      "repository": {
        "type": "file",
        "path": "."
      },
      "bindings": {
        "rules": "toolchain"
      }
    },
    "toolchain": {
      "repository": "toolchain/rules",
      "target_root": "toolchain/toolchain_root",
      "rule_root": "toolchain/rules",
      "target_file_name": "system.TARGETS"
    },
    "toolchain/rules": {
      "repository": {
        "type": "git",
        "repository": "https://github.com/just-buildsystem/rules-cc",
        "branch": "master",
        "commit": "457b1f9dda7366fbb4e6ac4664750bb2bab48e42",
        "subdir": "rules"
      }
    },
    "toolchain/toolchain_root": {
      "repository": {
        "type": "git",
        "repository": "https://gitee.com/justbuild/toolchains-cc.git",
        "branch": "master",
        "commit": "45a10f9ae99e175ac66d2c71fefdc5cca35f2dc4",
        "mirrors": [
          "https://github.com/just-buildsystem/toolchains-cc.git"
        ],
        "subdir": "toolchain"
      }
    }
  }
}