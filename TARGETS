// Options supported by this project
local options_doc = {
  OS: [|||
    Operating system to build for.

    Currently, the only supported value is "linux", which is also the
    default.
  |||],
  ARCH: [|||
    The underlying architecture. Is taken as a default for "HOST_ARCH" and
    "TARGET_ARCH".

    One of "x86", "x86_64", "arm", "arm64". Defaults to "x86_64".
  |||],
  HOST_ARCH: ['The architecture on which the build actions are carried out.'],
  TARGET_ARCH: ['The architecture for which to build the binary.'],
  TOOLCHAIN_CONFIG: [|||
    The toolchain configuration.

    Use field "FAMILY" to specify the compiler family.
    Supported values are "unknown" (the default), "clang", and "gnu".
    The unknown compiler family tries to not make any assumptions on the
    used C and C++ compilers and uses the generic "cc" and "c++" as
    names for the respective compilers; typically used in conjunction with
    setting "CC" and "CXX" explicitly and building for host.

    Use field "BUILD_STATIC" to specify that binaries should be
    statically linked. Boolean, default false.
  |||],
  ENV: [|||
    Map from strings to strings. The build environment to be used for
    build actions. Typically used to include an unusual value of PATH.
  |||],
  FINAL_LDFLAGS: ['Compiler flags for linking the final binary.'],
  DEBUG: [|||
    Map enabling and configuring the debug version.

    The key "USE_DEBUG_FISSION" enables debug fission, but does not add
    any flags. Explicitly setting it to a false value is needed to enable
    regular debug mode.
    The key "FISSION_CONFIG" expects a map configuring debug fission.
    - subkey "USE_SPLIT_DWARF" expects a flag that, if true, adds the
      -gsplit-dwarf compile flag.
    - subkey "DWARF_VERSION" expects a string that adds the
      -gdwarf-<value> compile flag.
    - subkey "USE_GDB_INDEX" expects a flag that, if true, adds the
      -Wl,--gdb-index linker flag.
    - subkey "USE_DEBUG_TYPES_SECTION" expects a flag that, if true,
      adds the -fdebug-types-section compile flag.
  |||],
  SOURCE_DATE_EPOCH: [|||
    If set, embed the given time stamp (in seconds since the epoch) into
    the binary.
  |||],
  VERSION_EXTRA_SUFFIX: [|||
    String to extend the version suffix with.

    Should be used to indicate additional (non-upstream) changes, e.g.,
    due to packaging.
  |||],
  CC: ['The C compiler to use.'],
  CXX: ['The C++ compiler to use.'],
  AR: ['The archiver to use.'],
  DWP: ['The DWARF packaging utility to use.'],
  ADD_CFLAGS: ['Additional C compiler flags.'],
  ADD_CXXFLAGS: ['Additional C++ compiler flags.'],
  PKG_CONFIG_ARGS: ['Additional pkg-config arguments.\n'],
  LOCALBASE: ['Use this localbase for building against system libs'],
  BUILD_MANPAGES: ['Generate manpages, requires pandoc in PATH (default: false)'],
};

// Default options for jst binaries.
local default_options =
  local arch = jst.env('ARCH', default='x86_64');
  {
    OS: jst.env('OS', default='linux'),
    ARCH: arch,
    HOST_ARCH: jst.env('HOST_ARCH', default=arch),
    TARGET_ARCH: jst.env('TARGET_ARCH', default=arch),
  };

{
  // Default target: installs the jst binaries, tools, and documentation into a
  // LOCALBASE-shaped tree (bin,lib,share,...).
  ALL: {
    type: 'export',
    target: 'INSTALL',
    doc: ['The jst installation.'],
    config_doc: options_doc,
    flexible_config: jst.keys(options_doc),
  },

  // Predefined target combining all binaries, tools, and accompanying
  // documentation.
  INSTALL: {
    type: 'install',
    arguments_config: ["BUILD_MANPAGES"],
    dirs:
      [['install_cc', '.']]
      + if $'BUILD_MANPAGES' then [['manpages', 'share/man']],
    files: {
      'bin/jst-lock': 'bin/jst-lock.py',
      'bin/jst-import-git': 'bin/jst-import-git.py',
      'bin/jst-deduplicate-repos': 'bin/jst-deduplicate-repos.py',
      'share/bash-completion/completions/jst': 'share/jst_complete.bash',
    },
  },

  // Development target installing all public headers from external libraries,
  // if they are bundled and not available in the local system. Useful for
  // setting up IDE code completion.
  DEV: {
    type: 'configure',
    arguments_config: ['OS', 'ARCH', 'HOST_ARCH', 'TARGET_ARCH'],
    target: @'//etc/dev:jst_extern_hdrs',
    config: default_options,
  },

  // The jst main binary.
  jst: {
    type: 'export',
    target: 'jst_configured',
    config_doc: options_doc,
    flexible_config: jst.keys(options_doc),
  },

  // The jst backend binary.
  jst_backend: {
    type: 'export',
    target: 'jst_backend_configured',
    config_doc: options_doc,
    flexible_config: jst.keys(options_doc),
  },

  // Sets default options (OS/ARCH) for the jst main binary.
  jst_configured: {
    type: 'configure',
    arguments_config: ['OS', 'ARCH', 'HOST_ARCH', 'TARGET_ARCH'],
    target: @'//src/other_tools/just_mr:jst',
    config: default_options,
  },

  // Sets default options (OS/ARCH) for the jst backend binary.
  jst_backend_configured: {
    type: 'configure',
    arguments_config: ['OS', 'ARCH', 'HOST_ARCH', 'TARGET_ARCH'],
    target: @'//src/buildtool/main:jst_backend',
    config: default_options,
  },

  // Installs the native binaries into a LOCALBASE-shaped tree (bin,lib,...).
  install_cc: {
    type: @'rules//CC:install-with-deps',
    targets: ['jst', 'jst_backend'],
  },

  // Generates manpages, requires pandoc in PATH.
  manpages: {
    type: 'generic',
    cmds: [|||
      pandoc -s -t man share/man/jst.1.md -o man1/jst.1
      pandoc -s -t man share/man/jst-lock.1.md -o man1/jst-lock.1
      pandoc -s -t man share/man/jst-import-git.1.md -o man1/jst-import-git.1
      pandoc -s -t man share/man/jst-deduplicate-repos.1.md -o man1/jst-deduplicate-repos.1
      pandoc -s -t man share/man/jst_backend.1.md -o man1/jst_backend.1
      pandoc -s -t man share/man/jstrc.5.md -o man5/jstrc.5
      pandoc -s -t man share/man/jst-repo-config.5.md -o man5/jst-repo-config.5
      pandoc -s -t man share/man/jst-lock-config.5.md -o man5/jst-lock-config.5
      pandoc -s -t man share/man/jst_backend-repo-config.5.md -o man5/jst_backend-repo-config.5
      pandoc -s -t man share/man/jst_backend-serve-config.5.md -o man5/jst_backend-serve-config.5
      pandoc -s -t man share/man/jst_backend-graph-file.5.md -o man5/jst_backend-graph-file.5
    |||],
    out_dirs: [
      'man1',
      'man5',
    ],
    deps: [jst.tree('share')],
  },

  // Configures the libgit2 external (only relevant if bundled).
  libgit2: {
    type: 'configure',
    target: @'libgit2//:git2',
    config: {
      USE_SHA1: 'OpenSSL',
      USE_SHA256: 'OpenSSL',
      USE_SSH: false,
      USE_HTTPS: 'OpenSSL',
      USE_GSSAPI: false,
    },
  },

  // Configures the libcurl external (only relevant if bundled).
  libcurl: {
    type: 'configure',
    target: @'libcurl//:curl',
    config: {
      ENABLE_ARES: true,
      CURL_DISABLE_DICT: true,
      CURL_DISABLE_FILE: true,
      CURL_DISABLE_FTP: false,
      CURL_DISABLE_GOPHER: true,
      CURL_DISABLE_IMAP: true,
      CURL_DISABLE_LDAP: true,
      CURL_DISABLE_LDAPS: true,
      CURL_DISABLE_MQTT: true,
      CURL_DISABLE_POP3: true,
      CURL_DISABLE_RTSP: true,
      CURL_DISABLE_SMB: true,
      CURL_DISABLE_SMTP: true,
      CURL_DISABLE_TELNET: true,
      CURL_DISABLE_TFTP: false,
      CURL_USE_LIBPSL: false,
      CURL_USE_LIBSSH2: false,
    },
  },

  // Configures the libarchive external (only relevant if bundled).
  libarchive: {
    type: 'configure',
    target: @'libarchive//:archive',
    config: {
      ENABLE_LIBB2: false,
      ENABLE_LZ4: false,
      ENABLE_LZMA: true,
      ENABLE_ZSTD: false,
      ENABLE_LIBXML2: false,
      ENABLE_EXPAT: false,
      ENABLE_PCREPOSIX: false,
      ENABLE_PCRE2POSIX: false,
      ENABLE_LIBGCC: false,
      ENABLE_CNG: false,
      XATTR_PROVIDER: 'gnu',
      ENABLE_ACL: false,
    },
  },

  'bootstrap-src': {
    type: 'install',
    tainted: ['test'],
    dirs: [
      [jst.tree('rules'), '.'],
      [jst.tree('etc'), '.'],
      [jst.tree('src/buildtool'), '.'],
      [jst.tree('src/other_tools'), '.'],
      [jst.tree('src/utils'), '.'],
      [jst.tree('extern'), '.'],
    ],
    deps: [
      'ROOT',
      'TARGETS',
      'bin/bootstrap-traverser.py',
      'bin/bootstrap.py',
      'bin/jst.py',
      'bin/parallel-bootstrap-traverser.py',
    ],
  },
}
