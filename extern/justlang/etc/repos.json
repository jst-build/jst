{
  "main": "justlang",
  "repositories": {
    "config": {
      "repository": {
        "type": "file",
        "path": "etc/config"
      }
    },
    "rules": {
      "repository": "toolchain",
      "target_root": "config",
      "rule_root": "toolchain",
      "bindings": {
        "toolchain": "toolchain"
      }
    },
    "justlang": {
      "repository": {
        "type": "file",
        "path": "."
      },
      "bindings": {
        "rules": "rules",
        "json": "json"
      }
    },
    "tests": {
      "repository": {
        "type": "file",
        "path": "test"
      },
      "bindings": {
        "rules": "rules",
        "json": "json",
        "catch2": "catch2",
        "justlang": "justlang"
      }
    },
    "lint": {
      "repository": {
        "type": "file",
        "path": "lint"
      },
      "bindings": {
        "rules": "rules",
        "clang": "clang-18",
        "justlang": "justlang",
        "tests": "tests"
      }
    },
    "toolchain": {
      "repository": "toolchain/rules",
      "target_root": "toolchain/targets",
      "rule_root": "toolchain/rules"
    },
    "toolchain/rules": {
      "repository": {
        "type": "git",
        "repository": "https://github.com/jst-build/rules-cc",
        "branch": "master",
        "commit": "c18d9413f8759f8c261a3af06edf0861ee9e2492",
        "subdir": "rules"
      }
    },
    "toolchain/targets": {
      "repository": {
        "type": "git",
        "repository": "https://github.com/jst-build/toolchains-cc.git",
        "branch": "system",
        "commit": "5505965c61432dea016055d0f12f483df40eb9ff",
        "subdir": "targets"
      }
    },
    "clang-18": {
      "repository": {
        "type": "archive",
        "fetch": "https://github.com/llvm/llvm-project/releases/download/llvmorg-18.1.8/clang+llvm-18.1.8-x86_64-linux-gnu-ubuntu-18.04.tar.xz",
        "sha256": "54ec30358afcc9fb8aa74307db3046f5187f9fb89fb37064cdde906e062ebf36",
        "content": "495971397e90fef8f731a1f1ad3ca1d25e845b9a",
        "subdir": "clang+llvm-18.1.8-x86_64-linux-gnu-ubuntu-18.04"
      },
      "target_root": "clang-18/targets",
      "target_file_name": "clang.TARGETS",
      "bindings": {
        "rules": "toolchain"
      }
    },
    "clang-18/targets": {
      "repository": {
        "type": "git",
        "repository": "https://github.com/jst-build/toolchains-cc.git",
        "branch": "clang-amd64-gnu/v18.1.8",
        "commit": "edbde570e42a23221098d41801575981f3a84ba7",
        "subdir": "targets"
      }
    },
    "json": {
      "repository": {
        "type": "zip",
        "content": "733571f96614cc01fcebf76c8359f52706677c61",
        "fetch": "https://github.com/nlohmann/json/releases/download/v3.11.3/include.zip",
        "sha256": "a22461d13119ac5c78f205d3df1db13403e58ce1bb1794edc9313677313f4a9d",
        "sha512": "8d923e2586acf736fc1886bf1839ca0126444ec60ce93a4bd18c21eef4475dff6f608203e42bf4968878dc50727a8c20c517dd8c1ac5c6b0bb6a95f2dce5546e",
        "subdir": "include/nlohmann"
      },
      "target_root": "json/targets",
      "bindings": {
        "rules": "toolchain"
      }
    },
    "json/targets": {
      "repository": {
        "type": "git",
        "repository": "https://github.com/jst-build/imports-cc.git",
        "branch": "nlohmann_json/v3.11.3",
        "commit": "f4208d0cda1dbf9a770a52afbf06078058db71e3",
        "subdir": "targets"
      }
    },
    "catch2": {
      "repository": {
        "type": "archive",
        "content": "5af653af0c54ad580176a8cadb5a1cef8c880372",
        "fetch": "https://github.com/catchorg/Catch2/archive/refs/tags/v3.5.3.tar.gz",
        "sha256": "8d723b0535c94860ef8cf6231580fa47d67a3416757ecb10639e40d748ab6c71",
        "sha512": "57c996f679cbad212cb0fde39e506bade37bd559c0e93e20f407f2a2f029e98b78661e10257f9c8e4cb5fd7d52d0ea1eae3d4a1f989c6d66fcb281e32e1688f6",
        "subdir": "Catch2-3.5.3"
      },
      "target_root": "catch2/targets",
      "bindings": {
        "rules": "toolchain"
      }
    },
    "catch2/targets": {
      "repository": {
        "type": "git",
        "repository": "https://github.com/jst-build/imports-cc.git",
        "branch": "catch2/v3.5.3",
        "commit": "e35bbc561cc40d0d89c401ebf58e7e2da6c7ddbb",
        "subdir": "targets"
      }
    }
  }
}