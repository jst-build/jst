{ "compiler":
  { "type": "export"
  , "target": ["cmd", "jsonnet"]
  , "flexible_config":
    [ "OS"
    , "ARCH"
    , "TARGET_ARCH"
    , "TOOLCHAIN_CONFIG"
    , "DEBUG"
    , "CC"
    , "CXX"
    , "CFLAGS"
    , "CXXFLAGS"
    , "LDFLAGS"
    , "ADD_CFLAGS"
    , "ADD_CXXFLAGS"
    , "ADD_LDFLAGS"
    , "AR"
    , "ENV"
    ]
  }
, "formatter":
  { "type": "export"
  , "target": ["cmd", "jsonnetfmt"]
  , "flexible_config":
    [ "OS"
    , "ARCH"
    , "TARGET_ARCH"
    , "TOOLCHAIN_CONFIG"
    , "DEBUG"
    , "CC"
    , "CXX"
    , "CFLAGS"
    , "CXXFLAGS"
    , "LDFLAGS"
    , "ADD_CFLAGS"
    , "ADD_CXXFLAGS"
    , "ADD_LDFLAGS"
    , "AR"
    , "ENV"
    ]
  }
, "libjsonnet":
  { "type": "export"
  , "target": "jsonnet"
  , "flexible_config":
    [ "OS"
    , "ARCH"
    , "TARGET_ARCH"
    , "TOOLCHAIN_CONFIG"
    , "DEBUG"
    , "CC"
    , "CXX"
    , "CFLAGS"
    , "CXXFLAGS"
    , "LDFLAGS"
    , "ADD_CFLAGS"
    , "ADD_CXXFLAGS"
    , "ADD_LDFLAGS"
    , "AR"
    , "ENV"
    ]
  }
, "libjsonnet_internals":
  { "type": "export"
  , "target": "jsonnet_internals"
  , "flexible_config":
    [ "OS"
    , "ARCH"
    , "TARGET_ARCH"
    , "TOOLCHAIN_CONFIG"
    , "DEBUG"
    , "CC"
    , "CXX"
    , "CFLAGS"
    , "CXXFLAGS"
    , "LDFLAGS"
    , "ADD_CFLAGS"
    , "ADD_CXXFLAGS"
    , "ADD_LDFLAGS"
    , "AR"
    , "ENV"
    ]
  }
, "jsonnet":
  { "type": ["@", "rules", "CC", "library"]
  , "name": ["jsonnet"]
  , "hdrs": [["include", "public_headers"]]
  , "private-cflags": ["-Wno-deprecated-declarations", "-Wno-c++17-extensions"]
  , "private-hdrs":
    [["core", "core_headers"], ["third_party", "third_party_headers"]]
  , "srcs":
    [ "core/desugarer.cpp"
    , "core/formatter.cpp"
    , "core/lexer.cpp"
    , "core/libjsonnet.cpp"
    , "core/parser.cpp"
    , "core/pass.cpp"
    , "core/static_analysis.cpp"
    , "core/string_utils.cpp"
    , "core/vm.cpp"
    , "third_party/md5/md5.cpp"
    , "third_party/rapidyaml/rapidyaml/src/c4/yml/tree.cpp"
    , "third_party/rapidyaml/rapidyaml/src/c4/yml/parse.cpp"
    , "third_party/rapidyaml/rapidyaml/src/c4/yml/common.cpp"
    , "third_party/rapidyaml/rapidyaml/src/c4/yml/preprocess.cpp"
    , "third_party/rapidyaml/rapidyaml/ext/c4core/src/c4/memory_resource.cpp"
    , "third_party/rapidyaml/rapidyaml/ext/c4core/src/c4/language.cpp"
    , "third_party/rapidyaml/rapidyaml/ext/c4core/src/c4/time.cpp"
    , "third_party/rapidyaml/rapidyaml/ext/c4core/src/c4/error.cpp"
    , "third_party/rapidyaml/rapidyaml/ext/c4core/src/c4/format.cpp"
    , "third_party/rapidyaml/rapidyaml/ext/c4core/src/c4/base64.cpp"
    , "third_party/rapidyaml/rapidyaml/ext/c4core/src/c4/char_traits.cpp"
    , "third_party/rapidyaml/rapidyaml/ext/c4core/src/c4/memory_util.cpp"
    ]
  }
, "jsonnet_internals":
  { "type": ["@", "rules", "CC", "library"]
  , "hdrs": [["core", "core_headers"], ["third_party", "third_party_headers"]]
  , "deps": ["libjsonnet"]
  }
, "std.jsonnet": {"type": "install", "deps": ["stdlib/std.jsonnet"]}
}
