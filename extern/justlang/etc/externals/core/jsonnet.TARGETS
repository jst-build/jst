{ "core_headers":
  { "type": "install"
  , "files": {"std.jsonnet.h": "generate_std.jsonnet.h"}
  , "deps":
    [ "ast.h"
    , "desugarer.h"
    , "formatter.h"
    , "json.h"
    , "lexer.h"
    , "parser.h"
    , "pass.h"
    , "state.h"
    , "static_analysis.h"
    , "static_error.h"
    , "string_utils.h"
    , "unicode.h"
    , "vm.h"
    ]
  }
, "generate_std.jsonnet.h":
  { "type": "generic"
  , "cmds":
    [ "((od -v -Anone -t u1 stdlib/std.jsonnet | tr ' ' '\\n' | grep -v '^$' | tr '\\n' ',' ) && echo '0') > std.jsonnet.h"
	  , "echo >> std.jsonnet.h"
    ]
  , "outs": ["std.jsonnet.h"]
  , "deps": [["", "std.jsonnet"]]
  }
}