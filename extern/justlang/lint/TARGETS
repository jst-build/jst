{
  LINT: {
    type: 'install',
    tainted: ['lint', 'test'],
    dirs: [
      ['run_clang_tidy', 'clang-tidy'],
      ['run_clang_format', 'clang-format'],
    ],
  },

  // Restage Clang installation (linters expect clang in directory 'toolchain')
  clang: {
    type: 'install',
    dirs: [[@'clang//:INSTALL', 'toolchain']],
  },

  run_clang_tidy: {
    type: @'rules//lint:targets',
    tainted: ['test'],
    name: ['clang-tidy'],
    linter: ['run_clang_tidy.py'],
    summarizer: ['summary.py'],
    config: [
      @'justlang//:.clang-tidy',
      'clang',
    ],
    targets: [
      @'justlang//src:justlangc',
      @'justlang//src/justlang:ref',
      @'justlang//src/justlang:preprocessor',
      @'tests//:ALL',
    ],
  },

  run_clang_format: {
    type: @'rules//lint:targets',
    tainted: ['test'],
    name: ['clang-format'],
    linter: ['run_clang_format.py'],
    summarizer: ['summary.py'],
    config: [
      @'justlang//:.clang-format',
      'clang',
    ],
    targets: [
      @'justlang//src:justlangc',
      @'justlang//src/justlang:ref',
      @'justlang//src/justlang:preprocessor',
      @'tests//:ALL',
    ],
  },
}
