{
  'git-import-under-test': {
    type: 'install',
    files: {
      'bin/git-import-under-test': @'src//:bin/jst-import-git.py',
    },
  },

  'deduplicate-tool-under-test': {
    type: 'install',
    files: {
      'bin/deduplicate-tool-under-test': @'src//:bin/jst-deduplicate-repos.py',
    },
  },

  'lock-tool-under-test': {
    type: 'install',
    files: {
      'bin/lock-tool-under-test': @'src//:bin/jst-lock.py',
    },
  },

  'remote tests (unconfigured)': {
    type: @'rules//test:matrix',
    arguments_config: ['TEST_COMPATIBLE_REMOTE', 'TEST_BOOTSTRAP_JUST_MR'],
    deps:
      [
        @'./remote-execution:TESTS',
        @'./just-mr:TESTS',
      ]
      + (if !jst.env('TEST_BOOTSTRAP_JUST_MR') then
           [
             @'./serve-service:TESTS',
             @'./computed-roots:TESTS',
             @'./tree-structure:TESTS',
             @'./symlinks:TESTS',
           ]),
  },

  'remote tests': {
    type: 'configure',
    tainted: ['test'],
    target: 'remote tests (unconfigured)',
    config: {
      TEST_MATRIX: {
        TEST_COMAPTIBLE_REMOTE: {
          'remote-compat': true,
          'remote-native': 'false',
        },
      },
    },
  },

  'just-mr tests (unconfigured)': {
    type: @'rules//test:suite',
    arguments_config: ['TEST_BOOTSTRAP_JUST_MR'],
    deps:
      [
        'remote tests',
        @'./built-in-rules:TESTS',
        @'./cli:TESTS',
        @'./just-lock:TESTS',
        @'./target-cache:TESTS',
        @'./gc:TESTS',
        @'./git-import:TESTS',
      ]
      + if !jst.env('TEST_BOOTSTRAP_JUST_MR') then
        [@'./profile:TESTS'],
  },

  'just-mr tests (matrix)': {
    type: @'rules//test:matrix',
    deps: ['just-mr tests (unconfigured)'],
  },

  'just-mr tests': {
    type: 'configure',
    tainted: ['test'],
    target: 'just-mr tests (matrix)',
    config: {
      TEST_MATRIX: {
        TEST_BOOTSTRAP_JUST_MR: {
          'just-mr-bootstrap': true,
          'just-mr-native': false,
        },
      },
    },
  },

  TESTS: {
    type: @'rules//test:suite',
    arguments_config: ['TEST_BOOTSTRAP_JUST_MR'],
    stage: ['end-to-end'],
    deps: [
      'just-mr tests',
      @'./actions:TESTS',
      @'./build-fails:TESTS',
      @'./execution-service:TESTS',
      @'./generated-binary:TESTS',
      @'./target-tests:TESTS',
      @'./user-errors:TESTS',
    ],
  },
}
