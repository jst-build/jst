{ "":
  { "type": "install"
  , "tainted": ["lint", "test"]
  , "deps": ["LINT"]
  , "files": {"REPORT": "lint-report", "format.diff": "format.diff"}
  }
, "LINT":
  { "type": "install"
  , "tainted": ["lint", "test"]
  , "dirs":
    [ ["LINT: clang-tidy", "clang-tidy"]
    , ["LINT: clang-format", "clang-format"]
    , ["LINT: strict_deps", "strict_deps"]
    ]
  }
, "clang":
  { "type": "generic"
  , "deps": [["@", "clang", "", "install_dir"]]
  , "cmds":
    [ "# rename install dir, as linters expect clang in directory 'toolchain'"
    , "rm -rf toolchain"
    , "mv installed_clang toolchain"
    ]
  , "out_dirs": ["toolchain"]
  }
, "configured_jst":
  { "type": "configure"
  , "arguments_config": ["OS", "ARCH"]
  , "config":
    { "type": "let*"
    , "bindings":
      [ ["OS", {"type": "var", "name": "OS", "default": "linux"}]
      , ["ARCH", {"type": "var", "name": "ARCH", "default": "x86_64"}]
      ]
    , "body": {"type": "env", "vars": ["OS", "ARCH"]}
    }
  , "target": ["@", "src", "src/other_tools/just_mr", "jst"]
  }
, "configured_jst_backend":
  { "type": "configure"
  , "arguments_config": ["OS", "ARCH"]
  , "config":
    { "type": "let*"
    , "bindings":
      [ ["OS", {"type": "var", "name": "OS", "default": "linux"}]
      , ["ARCH", {"type": "var", "name": "ARCH", "default": "x86_64"}]
      ]
    , "body": {"type": "env", "vars": ["OS", "ARCH"]}
    }
  , "target": ["@", "src", "src/buildtool/main", "jst_backend"]
  }
, "LINT: clang-tidy":
  { "type": ["@", "rules", "lint", "targets"]
  , "tainted": ["test"]
  , "name": ["clang-tidy"]
  , "linter": ["run_clang_tidy.py"]
  , "summarizer": ["summary.py"]
  , "config": [["@", "src", "", ".clang-tidy"], "clang"]
  , "targets":
    ["configured_jst", "configured_jst_backend", ["@", "tests", "", "ALL"]]
  }
, "LINT: clang-format":
  { "type": ["@", "rules", "lint", "targets"]
  , "tainted": ["test"]
  , "name": ["clang-format"]
  , "linter": ["run_clang_format.py"]
  , "summarizer": ["summary.py"]
  , "config": [["@", "src", "", ".clang-format"], "clang"]
  , "targets":
    ["configured_jst", "configured_jst_backend", ["@", "tests", "", "ALL"]]
  }
, "format.diff":
  { "type": "generic"
  , "tainted": ["lint", "test"]
  , "cmds": ["./create-diff.py"]
  , "outs": ["format.diff"]
  , "deps": ["LINT: clang-format", "create-diff.py"]
  }
, "LINT: strict_deps":
  { "type": ["@", "rules", "lint", "targets"]
  , "tainted": ["test"]
  , "name": ["strict deps"]
  , "linter": ["run_strict_deps.py"]
  , "summarizer": ["summary.py"]
  , "targets":
    ["configured_jst", "configured_jst_backend", ["@", "tests", "", "ALL"]]
  }
, "lint-report":
  { "type": "generic"
  , "tainted": ["lint", "test"]
  , "cmds": ["./combined-report.py"]
  , "outs": ["report"]
  , "deps": ["LINT", "combined-report.py"]
  }
}
