local cc = import '//CC/expressions.jst';
local cc_pkgconfig = import '//CC/pkgconfig/expressions.jst';

// Get values from field by name, or return the given default value
local get_field(name, default) =
  local val = jst.field(name);
  if val then val else default;

{
  defaults: {
    doc: 'A rule to provide defaults for pkgconfig',
    string_fields: ['pkg-config', 'PATH', 'PKG_CONFIG_PATH'],
    target_fields: ['base'],
    field_doc: {
      'pkg-config':
        'The name of the pkg-config binary to use, potentially with full path.',
      PATH: 'Additional paths to add to `PATH` when calling pkg-config',
      PKG_CONFIG_PATH: |||
        Additional paths to add to `PKG_CONFIG_PATH` when calling
        pkg-config
      |||,
      base: 'Other targets (using the same rule) to inherit from.',
    },
    expression:
      local pkg_config_tool = get_field('pkg-config', cc.defaults_base_provides(provider='pkg-config'));
      local path = jst.nub_left(
        jst.field('PATH')
        + cc.defaults_base_provides__concat(provider='PATH'),
      );
      local pkg_config_path = jst.nub_left(
        jst.field('PKG_CONFIG_PATH')
        + cc.defaults_base_provides__concat(provider='PKG_CONFIG_PATH'),
      );
      jst.result(
        provides={
          'pkg-config': pkg_config_tool,
          PATH: path,
          PKG_CONFIG_PATH: pkg_config_path,
        },
      ),
  },

  system_library: {
    doc: 'A system library via pkg-config',
    string_fields: ['name', 'args', 'stage'],
    implicit: {
      defaults: ['./..:defaults'],
      'shell defaults': ['//shell:defaults'],
      add_rpath: ['add_rpath'],
      'pkgconfig defaults': ['defaults'],
    },
    config_vars: ['PKG_CONFIG_ARGS', 'ENV'],
    field_doc: {
      name: 'The pkg-config name of the library.',
      args: |||
        Additional pkg-config arguments (e.g., `'--define-prefix'` or
        `'--static'`), appended to the config variable `PKG_CONFIG_ARGS`.
      |||,
      stage: 'The stage of the internally created flag files.',
      defaults: 'The C/C++ toolchain to use',
      'pkgconfig defaults': 'The pkgconfig configuration to use',
    },
    config_doc: {
      PKG_CONFIG_ARGS: |||
        Additional pkg-config arguments (e.g., `'--define-prefix'` or
        `'--static'`).
      |||,
      ENV: |||
        The environment for any action generated. May contain colon-separated
        `PKG_CONFIG_PATH` for looking up pkg-config files; this variable,
        as well as `PATH`, is prefixed by the values provided in
        the `defaults`.
      |||,
    },
    expression:
      local name = jst.assert_non_empty(
        jst.join(jst.field('name')),
        msg='system_library requires non-empty name',
      );
      local args = jst.env('PKG_CONFIG_ARGS', default=[]) + jst.field('args');
      local stage = jst.join(jst.field('stage'), sep='/');
      cc_pkgconfig.pkgconfig_result(name=name, args=args, stage=stage),
  },
}
