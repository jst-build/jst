local common = import '//expressions.jst';

{
  library: {
    doc: |||
      A proto library as abstract data structure.

      Such a library does not produce any artifacts itself, but it can be
      used as a dependency for various language-specific rules.
    |||,
    target_fields: ['srcs', 'deps'],
    bool_fields: ['service'],
    string_fields: ['stage', 'name'],
    field_doc: {
      srcs: 'The proto files for this library',
      deps: 'Any other proto library this library depends on',
      stage: |||
        The directory to stage the source files to.
        Directory components are joined by `'/'`.
      |||,
      name: 'The name of the (abstract) library.',
      service: |||
        If true, generate a service library (with access to `'rpc'`
        definitions) instead of a regular one.
      |||,
    },
    artifacts_doc: 'None',
    runfiles_doc: 'None',
    provides_doc: {
      proto: |||
        A list containing a single target-graph node with the definition of
        this proto library. The node types generated are `'library'` and
        `'service library'`.
      |||,
    },
    expression:
      local stage = jst.join(jst.field('stage'), sep='/');
      local name = jst.assert_non_empty(
        jst.join(jst.field('name')),
        msg='Have to provide a name, unique in the stage',
      );
      local srcs = [
        jst.value_node(
          jst.result(
            artifacts=jst.to_subdir(
              jst.union(
                common.field_artifacts_list(fieldname='srcs'),
                disjoint=true,
                msg='Sources have to be conflict free',
              ),
              subdir=stage,
            ),
          ),
        ),
      ];
      local deps = common.field_list_provider(
        fieldname='deps',
        provider='proto',
      );
      local name = [name];
      local stage = [stage];
      local proto = [
        jst.abstract_node(
          if jst.field('service') then 'service library' else 'library',
          string_fields={name: name, stage: stage},
          target_fields={srcs: srcs, deps: deps},
        ),
      ];
      jst.result(provides={proto: proto}),
  },
}
