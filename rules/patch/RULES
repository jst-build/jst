local common = import '//expressions.jst';
local cc = import '//CC/expressions.jst';
local patch = import '//patch/expressions.jst';
local shell = import '//shell/expressions.jst';
local transitions = import '//transitions/expressions.jst';

// Get values from field by name, or return the given default value
local get_field(name, default) =
  local val = jst.field(name);
  if val then val else default;

{
  defaults: {
    doc: |||
      A rule to provide defaults.
      All targets take their defaults for PATCH from the target
      `//patch:defaults`. This is probably the only sensible
      use of this rule. As targets form a different root, the defaults
      can be provided without changing this directory.
    |||,
    target_fields: ['base', 'toolchain'],
    string_fields: ['PATCH', 'PATH', 'SYSTEM_TOOLS'],
    field_doc: {
      base: 'Other targets (using the same rule) to inherit values from.',
      toolchain: |||
        Optional toolchain directory. A collection of artifacts that provide
        the tool PATCH. Note that only artifacts of
        the specified targets are considered (no runfiles etc.). Specifying
        this field extends artifacts from `base`.
      |||,
      PATCH: 'The patch binary to use',
      SYSTEM_TOOLS: |||
        List of tools (`'PATCH'`) that should be taken from
        the system instead of from `toolchain` (if specified).
      |||,
      PATH: |||
        Path for looking up the compilers. Individual paths are joined
        with `':'`. Specifying this field extends values from `base`.
      |||,
    },
    config_vars: ['ARCH', 'HOST_ARCH'],
    config_transitions: {
      toolchain: [transitions.for_host()],
    },
    expression:
      local patch_tool = get_field('PATCH', cc.defaults_base_provides(provider='PATCH'));
      local path = jst.nub_left(
        jst.field('PATH')
        + cc.defaults_base_provides__concat(provider='PATH'),
      );
      local env = cc.defaults_base_provides(provider='ENV', default={});
      local non_system_tools = jst.union(
        jst.flatten(
          [
            [cc.defaults_base_provides(
              provider='NON_SYSTEM_TOOLS',
              default={},
            )],
            if jst.field('PATCH') then
              [{PATCH: if jst.field('toolchain') then true else false}],
            [{[tool]: false} for tool in jst.field('SYSTEM_TOOLS')],
          ],
        ),
      );
      local toolchain = jst.union(
        cc.defaults_base_provides_list(provider='TOOLCHAIN', default={})
        + (if jst.field('toolchain') then
          common.field_artifacts_list(
            fieldname='toolchain',
            transition=transitions.for_host(),
          )),
        disjoint=true,
        msg='toolchain artifacts may not overlap',
      );
      jst.result(
        provides={
          PATCH: patch_tool,
          PATH: path,
          ENV: env,
          TOOLCHAIN: toolchain,
          NON_SYSTEM_TOOLS: non_system_tools,
        },
      ),
  },

  file: {
    doc: 'Replace a file, logically in place, by a patched version',
    target_fields: ['src', 'patch'],
    config_vars: ['PATCH', 'ENV'],
    implicit: {'patch-defaults': ['defaults'], defaults: ['//shell:defaults']},
    field_doc: {
      src: |||
        The single source file to patch, typically an explicit file reference.
      |||,
      patch: 'The patch to apply.',
      'patch-defaults': 'The patch binary (and toolchain) to use',
      defaults: 'The shell toolchain to use',
    },
    artifacts_doc:
      'The patched file, staged to the position the of the original file',
    runfiles_doc: 'Same as artifacts',
    expression:
      local toolchain_dir = 'toolchain';
      local toolchain = jst.union(
        [
          patch.default_toolchain(),
          cc.default_toolchain(),
        ],
        disjoint=true,
        msg='Staging conflict between patch and sh toolchain',
      );
      local toolchain = jst.to_subdir(toolchain, subdir=toolchain_dir);
      local bin_dirs = common.field_list_provider(
        fieldname='defaults',
        provider='bin dirs',
      );
      local bin_dirs = [
        jst.join(['./', toolchain_dir, '/', it])
        for it in bin_dirs
      ];
      local non_system_tools = patch.default_non_system_tools();
      local patch_tool = jst.env(
        'PATCH',
        default=jst.join(
          (if jst.get('PATCH', non_system_tools) then
            ['./', toolchain_dir, '/'])
          + patch.default_patch(),
        ),
      );
      local env = patch.default_env()
      + jst.env('ENV', default={});
      local env_path = jst.get('PATH', env);
      local env =
        env
        + {
          PATH: jst.join(
            jst.flatten(
              [
                patch.default_path(),
                cc.default_path(),
                bin_dirs,
                if env_path then [env_path],
              ],
            ),
            sep=':',
          ),
        };
      local sh = shell.sh(toolchain_dir=toolchain_dir);
      local orig = common.stage_singleton_field(
        fieldname='src',
        location='orig',
      );
      local patch = common.stage_singleton_field(
        fieldname='patch',
        location='patch',
      );
      local script = {
        'run_patch.sh': jst.make_blob(
          jst.join(
            [
              'set -e',
              'cp orig patched',
              'chmod +w patched',
              jst.join_cmd([patch_tool, 'patched', 'patch'])
              + ' >log || (cat log && exit 1)',
            ],
            sep='\n',
          ),
        ),
      };
      local inputs = jst.union([orig, patch, toolchain, script]);
      local patched = jst.action(
        inputs=inputs,
        cmd=[sh, './run_patch.sh'],
        outs=['patched'],
        env=env,
        label=jst.join(
          [
            'Patching file ',
            jst.basename(
              jst.join(
                jst.keys(
                  jst.union(
                    [jst.dep_artifacts(dep) for dep in jst.field('src')],
                  ),
                ),
              ),
            ),
          ],
        ),
      );
      local result = common.stage_artifact_to_singleton_field(
        artifact=patched,
        fieldname='src',
      );
      jst.result(artifacts=result, runfiles=result),
  },
}
